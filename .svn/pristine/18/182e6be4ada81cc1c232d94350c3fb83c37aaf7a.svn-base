import React, { useEffect, useRef, useContext } from "react";
import Sigma from "sigma";
import Graph from "graphology";
import { GraphContext } from "../GraphContext";
import { addRectangularGrid } from "../pages/rectGrid";
import { addHexLikeGrid } from "../pages/hexGrid";
import { addHopfieldCluster } from "../pages/hopfield";
import { serializeGraph } from "../utils/graphUtils";

export default function GraphCanvas({
  mode,
  gridMode,
  nodeSizePreset,
  hopfieldCount,
  rectRows,
  rectCols,
  hexRows,
  hexCols,
  onClearGraph,
  onGraphRefs,
}) {
  const { network } = useContext(GraphContext);

  const containerRef = useRef(null);
  const gridCanvasRef = useRef(null);

  const graphRef = useRef(new Graph({ type: "undirected" }));
  const sigmaRef = useRef(null);
  const nodeIdRef = useRef(0);
  const firstNodeRef = useRef(null);

  const modeRef = useRef(mode);
  const gridRef = useRef(gridMode);
  const nodeSizeRef = useRef(5);

  const clustersRef = useRef([]);
  const gridsRef = useRef([]);

  useEffect(() => {
    if (typeof onGraphRefs === "function") {
      onGraphRefs({ graphRef, sigmaRef });
    }
  }, [onGraphRefs]);

  useEffect(() => { modeRef.current = mode; }, [mode]);
  useEffect(() => { gridRef.current = gridMode; }, [gridMode]);
  useEffect(() => {
    nodeSizeRef.current =
      nodeSizePreset === "small" ? 4 :
      nodeSizePreset === "large" ? 8 : 5;
  }, [nodeSizePreset]);

  useEffect(() => {
    const container = containerRef.current;
    if (!container) return;

    const graph = graphRef.current;
    const sigma = new Sigma(graph, container, {
      renderLabels: false,
      allowInvalidContainer: true,
      settings: { mouseEnabled: true, enableCamera: true },
    });
    sigmaRef.current = sigma;

    sigma.setSetting("autoRescale", false);
    sigma.setSetting("autoRescaleOnNewNodes", false);
    sigma.setSetting("autoRescaleOnNewEdges", false);
    sigma.setSetting("autoRescaleOnResize", false);

    if (!graph.hasNode("__anchor1")) {
      graph.addNode("__anchor1", { x: -5000, y: -5000, hidden: true });
      graph.addNode("__anchor2", { x: 5000, y: 5000, hidden: true });
    }

    const cam = sigma.getCamera();

    requestAnimationFrame(() => {
      const center = sigma.viewportToGraph({
        x: container.clientWidth / 2,
        y: container.clientHeight / 2,
      });
      cam.setState({
        x: center.x,
        y: center.y,
        ratio: 1,
        angle: 0,
      });
    });

    if (network && graph.order === 0) {
      const N = network.N ?? 0;
      const layout = network.layout || [];
      for (let i = 0; i < N; i++) {
        const id = `n-${i + 1}`;
        const pos = layout[i] || { x: i * 60, y: 0 };
        graph.addNode(id, {
          x: pos.x,
          y: pos.y,
          size: nodeSizeRef.current,
          color: "#48dbfb",
          label: `Node ${id.split("-")[1]}`,
        });
      }
      const C = network.C || [];
      for (let i = 0; i < N; i++) {
        for (let j = i + 1; j < N; j++) {
          if (C[i] && C[i][j] === 1) {
            const a = `n-${i + 1}`;
            const b = `n-${j + 1}`;
            if (!graph.hasEdge(a, b))
              graph.addEdge(a, b, { color: "white" });
          }
        }
      }
      nodeIdRef.current = N;
    }

    let draggedNode = null;

    sigma.on("downNode", ({ node }) => {
      draggedNode = node;
      const color = firstNodeRef.current === node ? "orange" : "#38a8c2ff";
      graph.setNodeAttribute(node, "color", color);
      sigma.getCamera().disable();
      sigma.refresh();
    });

    sigma.on("upNode", () => {
      if (draggedNode) {
        const color = firstNodeRef.current === draggedNode ? "orange" : "#48dbfb";
        graph.setNodeAttribute(draggedNode, "color", color);
        draggedNode = null;
        sigma.refresh();
      }
      sigma.getCamera().enable();
    });

    sigma.getMouseCaptor().on("mousemove", (e) => {
      if (!draggedNode) return;
      const pos = sigma.viewportToGraph(e);
      const step = 25;
      const useGrid = gridRef.current;
      const x = useGrid ? Math.round(pos.x / step) * step : pos.x;
      const y = useGrid ? Math.round(pos.y / step) * step : pos.y;
      graph.setNodeAttribute(draggedNode, "x", x);
      graph.setNodeAttribute(draggedNode, "y", y);
      sigma.refresh();
    });

    sigma.on("clickNode", ({ node }) => {
      if (modeRef.current === "delete") {
        if (graph.hasNode(node)) {
          graph.dropNode(node);
          if (firstNodeRef.current === node) firstNodeRef.current = null;
        }
        sigma.refresh();
        return;
      }

      if (!firstNodeRef.current) {
        firstNodeRef.current = node;
        graph.setNodeAttribute(node, "color", "orange");
      } else if (firstNodeRef.current === node) {
        graph.setNodeAttribute(node, "color", "#48dbfb");
        firstNodeRef.current = null;
      } else {
        if (!graph.hasEdge(firstNodeRef.current, node)) {
          graph.addEdge(firstNodeRef.current, node, { color: "white" });
        } else {
          graph.dropEdge(firstNodeRef.current, node);
        }
        graph.setNodeAttribute(firstNodeRef.current, "color", "#48dbfb");
        firstNodeRef.current = null;
      }
      sigma.refresh();
    });

    sigma.getMouseCaptor().on("click", (e) => {
      const pos = sigma.viewportToGraph(e);
      const useGrid = gridRef.current;
      const step = 25;
      const cx = useGrid ? Math.round(pos.x / step) * step : pos.x;
      const cy = useGrid ? Math.round(pos.y / step) * step : pos.y;
      const graph = graphRef.current;

      const nextId = () => {
        nodeIdRef.current += 1;
        return `n-${nodeIdRef.current}`;
      };

      if (modeRef.current === "add") {
        const id = nextId();
        graph.addNode(id, {
          x: cx,
          y: cy,
          size: nodeSizeRef.current,
          color: "#48dbfb",
          label: `Node ${id.split("-")[1]}`,
        });
        sigma.refresh();
        return;
      }

      if (modeRef.current === "hopfield") {
        const n = Math.max(2, parseInt(hopfieldCount || "4", 10));
        const radius = 120;
        addHopfieldCluster({
          graph,
          cx,
          cy,
          count: n,
          radius,
          nodeSize: nodeSizeRef.current,
          nextId,
        });
        sigma.refresh();
        return;
      }

      if (modeRef.current === "rect") {
        const rows = Math.max(1, parseInt(rectRows || "3", 10));
        const cols = Math.max(1, parseInt(rectCols || "4", 10));
        const spacing = 60;
        addRectangularGrid({
          graph,
          cx,
          cy,
          rows,
          cols,
          spacing,
          nodeSize: nodeSizeRef.current,
          nextId,
        });
        sigma.refresh();
        return;
      }

      if (modeRef.current === "hex") {
        const rows = Math.max(1, parseInt(hexRows || "4", 10));
        const cols = Math.max(1, parseInt(hexCols || "6", 10));
        const spacing = 60;
        addHexLikeGrid({
          graph,
          cx,
          cy,
          rows,
          cols,
          spacing,
          nodeSize: nodeSizeRef.current,
          nextId,
        });
        sigma.refresh();
        return;
      }
    });

    const defaultNodeColor = "#48dbfb";
    const highlightColor = "red";

    sigma.on("enterNode", ({ node }) => {
      const graph = graphRef.current;
      const neighbors = new Set(graph.neighbors(node));
      graph.setNodeAttribute(node, "color", highlightColor);
      neighbors.forEach((n) => graph.setNodeAttribute(n, "color", highlightColor));
      graph.forEachEdge(node, (edge) => {
        graph.setEdgeAttribute(edge, "color", highlightColor);
      });
      sigma.setSetting("nodeReducer", (n, data) => {
        if (n === node || neighbors.has(n)) return data;
        return { ...data, color: "rgba(255,255,255,0.1)" };
      });
      sigma.setSetting("edgeReducer", (e, data) => {
        const ends = graph.extremities(e);
        if (ends.includes(node) || neighbors.has(ends[0]) || neighbors.has(ends[1])) return data;
        return { ...data, color: "rgba(255,255,255,0.05)" };
      });
      sigma.refresh();
    });

    sigma.on("leaveNode", () => {
      const graph = graphRef.current;
      graph.forEachNode((n) => graph.setNodeAttribute(n, "color", defaultNodeColor));
      graph.forEachEdge((e) => graph.setEdgeAttribute(e, "color", "white"));
      sigma.setSetting("nodeReducer", null);
      sigma.setSetting("edgeReducer", null);
      sigma.refresh();
    });

    const drawGrid = () => {
      const canvas = gridCanvasRef.current;
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      const dpr = window.devicePixelRatio || 1;
      const width = window.innerWidth;
      const height = window.innerHeight;

      canvas.style.width = width + "px";
      canvas.style.height = height + "px";
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, width, height);

      if (!gridRef.current) return;

      const sigma = sigmaRef.current;
      const spacingPx = 25;
      const originVp = sigma.graphToViewport({ x: 0, y: 0 });
      const offsetX = ((originVp.x % spacingPx) + spacingPx) % spacingPx;
      const offsetY = ((originVp.y % spacingPx) + spacingPx) % spacingPx;

      ctx.strokeStyle = "rgba(255,255,255,0.08)";
      ctx.lineWidth = 1;

      for (let x = offsetX; x <= width; x += spacingPx) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
        ctx.stroke();
      }
      for (let y = offsetY; y <= height; y += spacingPx) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
        ctx.stroke();
      }
    };

    cam.on("updated", drawGrid);
    window.addEventListener("resize", drawGrid);
    drawGrid();

    return () => {
      cam.off("updated", drawGrid);
      window.removeEventListener("resize", drawGrid);
      sigma.kill();
    };
  }, [network]);

  useEffect(() => {
    if (typeof onClearGraph === "function") {
      onClearGraph(() => {
        const graph = graphRef.current;
        graph.clear();
        nodeIdRef.current = 0;
        firstNodeRef.current = null;
        clustersRef.current = [];
        gridsRef.current = [];
        sigmaRef.current?.refresh();
      });
    }
  }, [onClearGraph]);

  return (
    <>
      <div
        ref={containerRef}
        className={`sandbox-container ${
          ["add", "hopfield", "rect", "hex"].includes(mode)
            ? "mode-draw"
            : mode === "delete"
            ? "mode-delete"
            : ""
        }`}
      />
      <canvas
        ref={gridCanvasRef}
        style={{
          position: "absolute",
          inset: 0,
          width: "100%",
          height: "100%",
          zIndex: 5,
          pointerEvents: "none",
          display: gridMode ? "block" : "none",
        }}
      />
    </>
  );
}
