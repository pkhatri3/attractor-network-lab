import React, { useMemo, useEffect, useState, useCallback } from "react";
import { computeLayoutOptions, buildMask } from "./layoutOptions";

const GAP = 2;

function cellColors({ isPad, on }) {
  if (isPad) {
    return {
      bg: "rgba(128,128,128,0.25)",
      fg: "rgba(255,255,255,0.35)",
      border: "1px solid rgba(255,255,255,0.12)",
      cursor: "default",
    };
  }
  if (on) {
    return {
      bg: "rgba(255,255,255,0.20)",
      fg: "#eaf4ff",
      border: "1px solid rgba(255,255,255,0.20)",
      cursor: "pointer",
    };
  }
  return {
    bg: "rgba(255,255,255,0.06)",
    fg: "#b9c6d2",
    border: "1px solid rgba(255,255,255,0.12)",
    cursor: "pointer",
  };
}

export default function StatePicker({
  neuronCount,
  approxContainerWidth,
  initialState = [],
  externalState,
  disabled = false,
  onStateChange,
  iteration = null,
}) {
  const options = useMemo(
    () => computeLayoutOptions(neuronCount, { approxContainerWidth }),
    [neuronCount, approxContainerWidth]
  );

  const [selected, setSelected] = useState(options[0] || null);
  const [currentState, setCurrentState] = useState([]);

  useEffect(() => {
    if (externalState && externalState.length === neuronCount) {
      setCurrentState(externalState);
      return;
    }
    if (neuronCount <= 0) {
      setCurrentState([]);
      return;
    }
    const cleaned =
      Array.isArray(initialState) && initialState.length === neuronCount
        ? initialState.map((v) => (v === 1 ? 1 : -1))
        : Array(neuronCount).fill(-1);
    setCurrentState(cleaned);
  }, [neuronCount, initialState, externalState]);

  const mask = useMemo(() => {
    if (!selected) return [];
    return buildMask(neuronCount, selected.base);
  }, [neuronCount, selected]);

  const maxCellSize = 40;
  const maxWidth = 600;
  const size = selected
    ? Math.min(maxCellSize, Math.floor(maxWidth / selected.cols))
    : maxCellSize;

  const handleCellClick = useCallback(
    (cellIndex) => {
      if (disabled || !selected || !mask[cellIndex]) return;
      if (cellIndex >= neuronCount) return;
      setCurrentState((prev) => {
        const next = [...prev];
        next[cellIndex] = next[cellIndex] === 1 ? -1 : 1;
        onStateChange?.(next, selected);
        return next;
      });
    },
    [mask, neuronCount, selected, onStateChange, disabled]
  );

  const handleLayoutChange = (e) => {
    if (disabled) return;
    const next = options.find((o) => o.key === e.target.value) || null;
    setSelected(next);
    if (next) onStateChange?.(currentState, next);
  };

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 12 }}>
      <div style={{ fontSize: 12, opacity: 0.9, marginBottom: 4 }}>
        Neuron Layout (view):
      </div>

      <select
        value={selected?.key || ""}
        onChange={handleLayoutChange}
        disabled={disabled}
        style={{
          width: "100%",
          padding: 8,
          borderRadius: 10,
          background: "rgba(255,255,255,0.06)",
          color: "#eaf4ff",
          border: "1px solid rgba(255,255,255,0.12)",
          cursor: disabled ? "not-allowed" : "pointer",
          opacity: disabled ? 0.6 : 1,
        }}
      >
        {options.map((opt) => (
          <option key={opt.key} value={opt.key} style={{ color: "black" }}>
            {opt.label}
          </option>
        ))}
      </select>

      {selected && (
        <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
          <div style={{ fontSize: 12, opacity: 0.9, marginBottom: 2 }}>
            Set Initial State A
          </div>

          {/* Interactive neuron grid */}
          <div
            style={{
              display: "grid",
              gridTemplateColumns: `repeat(${selected.cols}, ${size}px)`,
              gap: GAP,
              alignSelf: "start",
              opacity: disabled ? 0.85 : 1,
            }}
          >
            {Array.from({ length: selected.base }).map((_, idx) => {
              const isReal = mask[idx];
              const on = isReal ? currentState[idx] === 1 : false;
              const { bg, fg, border, cursor } = cellColors({
                isPad: !isReal,
                on,
              });

              return (
                <div
                  key={idx}
                  onClick={() => handleCellClick(idx)}
                  style={{
                    width: size,
                    height: size,
                    borderRadius: 6,
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    background: bg,
                    color: fg,
                    border,
                    fontFamily: "monospace",
                    fontSize: 12,
                    userSelect: "none",
                    cursor: disabled ? "not-allowed" : cursor,
                  }}
                  title={!isReal ? "Padding" : on ? "+1" : "-1"}
                >
                  {!isReal ? "—" : on ? "1" : "-1"}
                </div>
              );
            })}
          </div>

          <div
            style={{
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              marginTop: 8,
              width: "100%",
              opacity: disabled ? 0.6 : 1,
            }}
          >
            <button
              onClick={() => {
                if (disabled) return;
                const cleared = Array(neuronCount).fill(-1);
                setCurrentState(cleared);
                onStateChange?.(cleared);
              }}
              disabled={disabled}
              style={{
                padding: "6px 10px",
                borderRadius: 8,
                border: "1px solid rgba(255,255,255,0.12)",
                background: "rgba(255,255,255,0.08)",
                color: "#eaf4ff",
                cursor: disabled ? "not-allowed" : "pointer",
                fontSize: 12,
                fontWeight: 600,
                opacity: disabled ? 0.6 : 1,
              }}
            >
              Clear
            </button>

            {iteration !== null && (
              <div
                style={{
                  flex: 1,
                  textAlign: "center",
                  fontSize: 13,
                  color: "#aaa",
                  fontWeight: 500,
                }}
              >
                Iteration {iteration}
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
}
