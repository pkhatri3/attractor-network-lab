import React, { useState, useContext, useEffect, useRef } from "react";
import { GraphContext } from "../GraphContext";
import { LearningContext } from "../LearningContext";
import StatePicker from "./StatePicker";
import { Link } from "react-router-dom";
import {
  LineChart,
  Line,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
} from "recharts";

const API_URL = import.meta.env.VITE_API_URL;



function WeightsCanvas({ matrix, size = 500, scaleFactor = 2 }) {
  const canvasRef = React.useRef();
  const [showNumbers, setShowNumbers] = React.useState(true);

  React.useEffect(() => {
    if (!matrix || !matrix.length || !matrix[0].length) return;

    const rows = matrix.length;
    const cols = matrix[0].length;
    const canvas = canvasRef.current;
    const ctx = canvas.getContext("2d");

    const dispW = size;
    const dispH = size;
    const sf = Math.max(1, scaleFactor || 1);
    const outW = Math.floor(dispW * sf);
    const outH = Math.floor(dispH * sf);

    canvas.width = outW;
    canvas.height = outH;
    canvas.style.width = `${dispW}px`;
    canvas.style.height = `${dispH}px`;

    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, outW, outH);

    let min = Infinity,
      max = -Infinity;
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const v = matrix[r][c];
        if (v < min) min = v;
        if (v > max) max = v;
      }
    }
    if (!isFinite(min)) min = -1;
    if (!isFinite(max)) max = 1;

    const getRGB = (v) => {
      if (v === 0) return [200, 200, 200];
      if (v > 0) {
        const norm = v / (max || 1);
        return [
          Math.round(200 + 55 * norm),
          Math.round(200 - 200 * norm),
          Math.round(200 - 200 * norm),
        ];
      } else {
        const norm = v / (min || -1);
        return [
          Math.round(200 - 200 * norm),
          Math.round(200 - 200 * norm),
          Math.round(200 + 55 * norm),
        ];
      }
    };

    const img = ctx.createImageData(outW, outH);
    const data = img.data;
    let p = 0;
    for (let y = 0; y < outH; y++) {
      const rIdx = Math.floor((y * rows) / outH);
      const row = matrix[rIdx];
      for (let x = 0; x < outW; x++) {
        const cIdx = Math.floor((x * cols) / outW);
        const v = row[cIdx];
        const [R, G, B] = getRGB(v);
        data[p++] = R;
        data[p++] = G;
        data[p++] = B;
        data[p++] = 255;
      }
    }
    ctx.putImageData(img, 0, 0);

    const cellW = outW / cols;
    const cellH = outH / rows;
    const canDrawNumbers =
      showNumbers && rows <= 50 && cols <= 50 && cellW >= 24 && cellH >= 24;

    if (canDrawNumbers) {
      ctx.fillStyle = "#000";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.font = `${Math.max(10, Math.floor(cellH * 0.4))}px monospace`;
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const val = matrix[r][c];
          const cx = c * cellW + cellW / 2;
          const cy = r * cellH + cellH / 2;
          ctx.fillText(Number(val).toFixed(1), cx, cy);
        }
      }
    }
  }, [matrix, size, scaleFactor, showNumbers]);

  const downloadAsPNG = () => {
    const url = canvasRef.current.toDataURL("image/png");
    const a = document.createElement("a");
    a.href = url;
    a.download = "weights.png";
    a.click();
  };

  const downloadAsJSON = () => {
    const blob = new Blob([JSON.stringify(matrix)], {
      type: "application/json",
    });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "weights.json";
    a.click();
    URL.revokeObjectURL(url);
  };

  return (
    <div style={{ textAlign: "center" }}>
      <canvas
        ref={canvasRef}
        style={{ border: "1px solid #444", borderRadius: 8 }}
      />
      <div
        style={{
          marginTop: 10,
          display: "flex",
          justifyContent: "center",
          gap: 8,
          flexWrap: "wrap",
        }}
      >
        <button onClick={downloadAsPNG}>Download PNG</button>
        <button onClick={downloadAsJSON}>Download JSON</button>
        {matrix &&
          matrix.length * matrix[0].length < 10_000 && (
            <button onClick={() => setShowNumbers((v) => !v)}>
              {showNumbers ? "Hide Numbers" : "Show Numbers"}
            </button>
          )}
      </div>
    </div>
  );
}

export default function SimulationPhase() {
  const { network } = useContext(GraphContext);
  const {
    WHist,
    memories,
    capacityTestActive,
    setCapacityTestActive,
    capacityResults,
    setCapacityResults,
    capacityNoiseLevel,
    setCapacityNoiseLevel,
  } = useContext(LearningContext);

  const neuronCount = Array.isArray(network?.C) ? network.C.length : 0;
  const [gridCols, setGridCols] = useState(neuronCount);

  const [inputMode, setInputMode] = useState("text");
  const [Atext, setAtext] = useState("");
  const [Avec, setAvec] = useState([]);

  const [AHist, setAHist] = useState([]);
  const [energyHist, setEnergyHist] = useState([]);
  const [iter, setIter] = useState(0);
  const [error, setError] = useState(null);
  const [isSimulating, setIsSimulating] = useState(false);
  const abortRef = useRef(null);

  const [initialA, setInitialA] = useState(null);
  const [showW, setShowW] = useState(false);
  const [showMemories, setShowMemories] = useState(false);

  const handleRunCapacityTest = async () => {
    try {
      if (!network || !network.C) {
        setError("No network available. Complete the Construction and Learning phases first.");
        return;
      }
      if (!API_URL) {
        setError("VITE_API_URL is not set.");
        return;
      }
      if (!WHist || WHist.length === 0) {
        setError("No weights available. Complete the Learning phase first.");
        return;
      }

      setError(null);

      // Parse memories from context
      let parsedMemories;
      try {
        parsedMemories = typeof memories === 'string' ? JSON.parse(memories) : memories;
      } catch {
        setError("Invalid memories format.");
        return;
      }

      if (!Array.isArray(parsedMemories) || parsedMemories.length === 0) {
        setError("No memories loaded. Import memories in the Learning phase first.");
        return;
      }
      
      if (parsedMemories.length < 2) {
        setError("Need at least 2 memories to test capacity.");
        return;
      }

      const Nnet = network.C.length;
      const memWidth = Array.isArray(parsedMemories[0]) ? parsedMemories[0].length : 0;
      if (Nnet > 0 && memWidth !== Nnet) {
        setError(`Neuron count mismatch: memories have ${memWidth} neurons, network expects ${Nnet}.`);
        return;
      }

      // Convert memories to +1/-1 format
      const effectiveMemories = parsedMemories.map(row => 
        row.map(v => (v === 1 ? 1 : -1))
      );

      setCapacityTestActive(true);
      setCapacityResults([]);

      const payload = {
        memories: effectiveMemories,
        C: network.C,
        learning_rate: 0.25,
        scale: 1.0,
        rule: "standard",
        noise_level: capacityNoiseLevel,
        max_iters: 50,
      };

      const res = await fetch(`${API_URL}/memory_capacity_test`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!res.ok) throw new Error(`Backend error: ${res.status}`);

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = "";
      const results = [];

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split("\n");
        buffer = lines.pop() || "";

        for (const line of lines) {
          if (line.startsWith("data: ")) {
            const dataStr = line.slice(6);
            try {
              const parsed = JSON.parse(dataStr);
              if (parsed.done) {
                setCapacityTestActive(false);
                console.log("Capacity test complete!");
              } else if (parsed.error) {
                setError(parsed.error);
                setCapacityTestActive(false);
              } else if (parsed.num_patterns !== undefined) {
                results.push(parsed);
                setCapacityResults([...results]);
              }
            } catch (e) {
              console.error("Failed to parse SSE data:", e);
            }
          }
        }
      }
    } catch (err) {
      console.error("Error during capacity test:", err);
      setError(err.message || "Capacity test failed.");
      setCapacityTestActive(false);
    }
  };

  const parseA = (str) => {
    try {
      const p = JSON.parse(str);
      if (Array.isArray(p) && p.length === neuronCount)
        return p.map((v) => (v === 1 ? 1 : -1));
    } catch {
      return [];
    }
    return [];
  };

  const handleTextChange = (str) => {
    setAtext(str);
    const parsed = parseA(str);
    if (parsed.length === neuronCount) setAvec(parsed);
  };

  const stopSimulation = () => {
    if (abortRef.current) {
      abortRef.current.abort();
      abortRef.current = null;
    }
    setIsSimulating(false);
  };

  useEffect(() => () => stopSimulation(), []);

  const canSimulate =
    neuronCount > 0 && Avec.length === neuronCount && WHist?.length;

  async function onStartSimulation() {
    if (!canSimulate) return;
    setError(null);
    setAHist([]);
    setEnergyHist([]);
    setIter(0);
    stopSimulation();
    setInitialA([...Avec]);
    setIsSimulating(true);

    try {
      const controller = new AbortController();
      abortRef.current = controller;

      const res = await fetch(`${API_URL}/simulate_stream`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          A: Avec,
          W: WHist[WHist.length - 1],
          max_iters: 200,
        }),
        signal: controller.signal,
      });

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = "";

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const parts = buffer.split("\n\n");
        buffer = parts.pop();

        for (const part of parts) {
          const line = part.trim();
          if (!line.startsWith("data:")) continue;
          const payload = line.slice(5).trim();
          if (!payload) continue;
          let data;
          try {
            data = JSON.parse(payload);
          } catch {
            continue;
          }

          if (data.done) {
            setIsSimulating(false);
            return;
          }

          if (data.A) {
            setAHist((prev) => {
              if (
                prev.length > 0 &&
                JSON.stringify(prev[prev.length - 1]) === JSON.stringify(data.A)
              )
                return prev;
              const next = [...prev, data.A];
              setIter(next.length - 1);
              if (inputMode === "text") {
                setAtext(JSON.stringify(data.A));
                setAvec(data.A);
              }
              return next;
            });

            if (data.E !== undefined) {
              setEnergyHist((prev) => {
                if (prev.length > 0 && prev[prev.length - 1] === data.E)
                  return prev;
                return [...prev, data.E];
              });
            }
          }
        }
      }
    } catch (e) {
      if (e.name !== "AbortError") setError(e.message);
    }
  }

  const handleReset = () => {
    if (initialA) {
      setAvec(initialA);
      setAtext(JSON.stringify(initialA));
      setAHist([]);
      setEnergyHist([]);
      setIter(0);
      stopSimulation();
    }
  };

  const finalW = WHist?.[WHist.length - 1] || null;

  let parsedMems = [];
  try {
    parsedMems = Array.isArray(memories)
      ? memories
      : JSON.parse(memories || "[]");
  } catch {
    parsedMems = [];
  }

  return (
    <div
      style={{
        minHeight: "100vh",
        width: "100%",
        background: "#0f141a",
        color: "#eaf4ff",
        display: "flex",
        flexDirection: "column",
        padding: 20,
        overflowX: "hidden",
      }}
    >
      <Link
        to="/learning"
        style={{
          position: "absolute",
          top: 20,
          left: 20,
          padding: "10px 12px",
          borderRadius: 12,
          border: "1px solid rgba(255,255,255,0.12)",
          background: "#1a6fd6",
          color: "#eaf4ff",
          textDecoration: "none",
          fontWeight: 600,
          boxShadow: "0 8px 24px rgba(0,0,0,0.35)",
          backdropFilter: "blur(8px)",
        }}
      >
        Back to Learning
      </Link>

      <div
        style={{
          display: "flex",
          gap: 20,
          alignItems: "flex-start",
          height: "100%",
        }}
      >
        {/* Left: Simulation controls */}
        <div
          style={{
            flex: "0 0 auto",
            display: "flex",
            flexDirection: "column",
            gap: 16,
            width: "49%",
            marginTop: "5%",
          }}
        >
          <div
            style={{
              background: "rgba(20,20,26,0.92)",
              border: "1px solid rgba(255,255,255,0.1)",
              borderRadius: 16,
              padding: 20,
              minHeight: "300px",
              display: "flex",
              flexDirection: "row",
              gap: 20,
            }}
          >
            {/* Left Controls */}
            <div
              style={{
                display: "flex",
                flexDirection: "column",
                gap: 12,
                width: "160px",
              }}
            >
              <div style={{ display: "flex", gap: 4 }}>
                <button
                  onClick={() => setInputMode("text")}
                  style={{
                    flex: 1,
                    padding: "6px 8px",
                    borderRadius: 6,
                    border:
                      inputMode === "text"
                        ? "2px solid #1a6fd6"
                        : "1px solid #ccc",
                    background:
                      inputMode === "text" ? "#1a6fd6" : "transparent",
                    color: inputMode === "text" ? "#fff" : "#eaf4ff",
                    cursor: "pointer",
                    fontSize: 12,
                    fontWeight: 600,
                  }}
                >
                  Text
                </button>
                <button
                  onClick={() => setInputMode("matrix")}
                  style={{
                    flex: 1,
                    padding: "6px 8px",
                    borderRadius: 6,
                    border:
                      inputMode === "matrix"
                        ? "2px solid #1a6fd6"
                        : "1px solid #ccc",
                    background:
                      inputMode === "matrix" ? "#1a6fd6" : "transparent",
                    color: inputMode === "matrix" ? "#fff" : "#eaf4ff",
                    cursor: "pointer",
                    fontSize: 12,
                    fontWeight: 600,
                  }}
                >
                  Matrix
                </button>
              </div>

              <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
                <button
                  onClick={onStartSimulation}
                  disabled={!canSimulate || isSimulating}
                  style={{
                    padding: "8px",
                    borderRadius: 8,
                    border: "1px solid rgba(255,255,255,0.12)",
                    background:
                      canSimulate && !isSimulating ? "#1a6fd6" : "#555",
                    color: "#eaf4ff",
                    cursor:
                      canSimulate && !isSimulating ? "pointer" : "not-allowed",
                    fontWeight: 600,
                    fontSize: 13,
                  }}
                >
                  Start
                </button>

                <button
                  onClick={handleReset}
                  disabled={!isSimulating}
                  style={{
                    padding: "8px",
                    borderRadius: 8,
                    border: "1px solid rgba(255,255,255,0.12)",
                    background: isSimulating ? "#1a6fd6" : "#555",
                    color: "#eaf4ff",
                    cursor: isSimulating ? "pointer" : "not-allowed",
                    fontWeight: 600,
                    fontSize: 13,
                  }}
                >
                  Reset
                </button>
              </div>
            </div>

            {/* Right: Input field or matrix */}
            <div
              style={{
                flex: 1,
                display: "flex",
                flexDirection: "column",
                alignItems: "center",
              }}
            >
              {inputMode === "text" ? (
                <>
                  <textarea
                    value={Atext}
                    onChange={(e) => handleTextChange(e.target.value)}
                    rows={6}
                    disabled={isSimulating}
                    style={{
                      width: "100%",
                      padding: 8,
                      borderRadius: 10,
                      background: "rgba(255,255,255,0.06)",
                      color: "#eaf4ff",
                      border: "1px solid rgba(255,255,255,0.12)",
                      fontFamily: "monospace",
                    }}
                    placeholder={`Enter A like: [1, -1, 1, ...] with ${neuronCount} entries`}
                  />
                  <div
                    style={{
                      marginTop: 8,
                      fontSize: 13,
                      color: "#aaa",
                      fontWeight: 500,
                      textAlign: "center",
                    }}
                  >
                    Iteration {iter}
                  </div>
                </>
              ) : (
                <StatePicker
                  neuronCount={neuronCount}
                  approxContainerWidth={480}
                  initialState={Avec}
                  externalState={isSimulating ? AHist[iter] : null}
                  disabled={isSimulating}
                  iteration={isSimulating ? iter : null}
                  onStateChange={(newState, layout) => {
                    if (!isSimulating) {
                      setAvec(newState);
                      setAtext(JSON.stringify(newState));
                      setGridCols(layout?.cols || neuronCount);
                    }
                  }}
                />
              )}
            </div>
          </div>
          {error && <div style={{ color: "tomato" }}>{error}</div>}
        </div>

        {/* Right: visualization panels */}
        <div
          style={{
            flex: "0 0 auto",
            background: "rgba(20,20,26,0.92)",
            border: "1px solid rgba(255,255,255,0.1)",
            borderRadius: 16,
            padding: 20,
            overflowY: "auto",
            width: "40%",
            marginTop: "5%",
          }}
        >
          {/* W matrix */}
          <div style={panel}>
            <div
              style={panelHeader}
              onClick={() => setShowW((p) => !p)}
            >
              <span
                style={{
                  transform: showW ? "rotate(90deg)" : "rotate(0deg)",
                  transition: "0.2s",
                  display: "inline-block",
                }}
              >
                ▶
              </span>
              <h3 style={{ margin: 0 }}>W</h3>
            </div>
            {showW && (
              <div style={{ marginTop: 12 }}>
                {finalW ? (
                  <WeightsCanvas matrix={finalW} size={400} />
                ) : (
                  <p>No weights available yet.</p>
                )}
              </div>
            )}
          </div>

          {/* Memories */}
          <div style={panel}>
            <div
              style={panelHeader}
              onClick={() => setShowMemories((p) => !p)}
            >
              <span
                style={{
                  transform: showMemories ? "rotate(90deg)" : "rotate(0deg)",
                  transition: "0.2s",
                  display: "inline-block",
                }}
              >
                ▶
              </span>
              <h3 style={{ margin: 0 }}>Memories</h3>
            </div>
            {showMemories && (
              <div style={{ marginTop: 12 }}>
                {parsedMems.length ? (
                  <div
                    style={{
                      background: "rgba(255,255,255,0.05)",
                      border: "1px solid rgba(255,255,255,0.1)",
                      borderRadius: 8,
                      padding: 12,
                      fontFamily: "monospace",
                      fontSize: 12,
                      whiteSpace: "pre-wrap",
                      wordBreak: "break-word",
                      overflowY: "auto",
                      maxHeight: 200,
                    }}
                  >
                    {parsedMems.map((m, i) => (
                      <div key={i}>
                        #{i + 1}: {JSON.stringify(m)}
                      </div>
                    ))}
                  </div>
                ) : (
                  <p style={{ color: "#aaa" }}>No memories available.</p>
                )}
              </div>
            )}
          </div>

          {/* Energy plot */}
          <div style={panel}>
            <h3 style={{ marginTop: 0 }}>Network Energy</h3>
            {energyHist.length ? (
              <ResponsiveContainer width="100%" height={250}>
                <LineChart data={energyHist.map((E, t) => ({ t, E }))}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#333" />
                  <XAxis
                    dataKey="t"
                    label={{
                      value: "Timestep",
                      position: "insideBottom",
                      fill: "#999",
                    }}
                    tick={{ fill: "#999" }}
                  />
                  <YAxis
                    label={{
                      value: "Energy",
                      angle: -90,
                      position: "insideLeft",
                      fill: "#999",
                    }}
                    tick={{ fill: "#999" }}
                  />
                  <Tooltip
                    contentStyle={{
                      backgroundColor: "#2a2a2a",
                      border: "1px solid #444",
                    }}
                    labelStyle={{ color: "#fff" }}
                    itemStyle={{ color: "#1a6fd6" }}
                  />
                  <Line
                    type="monotone"
                    dataKey="E"
                    stroke="#1a6fd6"
                    strokeWidth={2}
                    dot={false}
                    isAnimationActive={false}
                  />
                </LineChart>
              </ResponsiveContainer>
            ) : (
              <div
                style={{
                  textAlign: "center",
                  padding: 40,
                  color: "#666",
                  fontStyle: "italic",
                }}
              >
                Run simulation to see energy evolution
              </div>
            )}
          </div>

          {/* Memory Capacity Test UI */}
          <div style={panel}>
            <h3 style={{ marginTop: 0, marginBottom: 8, color: "#eaf4ff", fontSize: 16 }}>
              Memory Capacity Test
              {capacityTestActive && (
                <span style={{
                  marginLeft: 12,
                  fontSize: 14,
                  fontWeight: 400,
                  color: "#1a6fd6",
                  animation: "pulse 1.5s infinite"
                }}>
                  Running...
                </span>
              )}
            </h3>
            <p style={{ fontSize: 12, opacity: 0.8, marginBottom: 16, color: "#ccc", lineHeight: 1.4 }}>
              Test how well the network recalls patterns as more memories are added.
            </p>

            <div style={{ marginBottom: 20, padding: 12, background: 'rgba(255,255,255,0.04)', borderRadius: 8 }}>
              <div style={{ fontSize: 13, marginBottom: 8, fontWeight: 600, color: "#eaf4ff" }}>
                Noise Level: {(capacityNoiseLevel * 100).toFixed(0)}%
              </div>
              <input
                type="range"
                min={0}
                max={0.5}
                step={0.01}
                value={capacityNoiseLevel}
                onChange={e => setCapacityNoiseLevel(Number(e.target.value))}
                style={{ width: '100%', cursor: capacityTestActive ? 'not-allowed' : 'pointer' }}
                disabled={capacityTestActive}
              />
              <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 10, opacity: 0.6, marginTop: 4 }}>
                <span>0%</span>
                <span>25%</span>
                <span>50%</span>
              </div>
            </div>

            <button
              style={{ 
                width: '100%',
                padding: '12px 16px', 
                borderRadius: 10, 
                background: capacityTestActive ? '#555' : '#1a6fd6', 
                color: '#fff', 
                border: 'none', 
                fontWeight: 600, 
                fontSize: 14,
                cursor: capacityTestActive ? 'not-allowed' : 'pointer',
                transition: 'background 0.2s',
                boxShadow: capacityTestActive ? 'none' : '0 4px 12px rgba(26,111,214,0.3)'
              }}
              onClick={handleRunCapacityTest}
              disabled={capacityTestActive}
            >
              {capacityTestActive ? 'Running Test...' : 'Run Capacity Test'}
            </button>
            {capacityResults && capacityResults.length > 0 ? (
              <>
                <ResponsiveContainer width="100%" height={300}>
                  <LineChart data={capacityResults}>
                    <CartesianGrid strokeDasharray="3 3" stroke="#333" />
                    <XAxis
                      dataKey="num_patterns"
                      label={{ value: 'Number of Patterns Stored', position: 'insideBottom', offset: -5, fill: '#999' }}
                      stroke="#666"
                      tick={{ fill: '#999' }}
                    />
                    <YAxis
                      domain={[0, 'dataMax']}
                      allowDecimals={false}
                      label={{ value: 'Memories Recalled', angle: -90, position: 'insideLeft', fill: '#999' }}
                      stroke="#666"
                      tick={{ fill: '#999' }}
                    />
                    <Tooltip
                      contentStyle={{ backgroundColor: '#2a2a2a', border: '1px solid #444' }}
                      labelStyle={{ color: '#fff' }}
                      itemStyle={{ color: '#1a6fd6' }}
                      formatter={(value, name) => {
                        if (name === 'success_count') return [value, 'Recalled'];
                        return [value, name];
                      }}
                    />
                    <Line
                      type="monotone"
                      dataKey="success_count"
                      stroke="#1a6fd6"
                      strokeWidth={3}
                      dot={{ fill: '#1a6fd6', r: 4 }}
                      isAnimationActive={false}
                    />
                  </LineChart>
                </ResponsiveContainer>
                {!capacityTestActive && capacityResults.length > 0 && (
                  <div style={{
                    marginTop: 15,
                    padding: 12,
                    background: 'rgba(26,111,214,0.12)',
                    border: '1px solid rgba(26,111,214,0.4)',
                    borderRadius: 8,
                    fontSize: 13,
                    color: '#1a6fd6'
                  }}>
                    ✓ Test complete! Tested {capacityResults[capacityResults.length - 1]?.num_patterns} patterns total.
                  </div>
                )}
              </>
            ) : (
              <div style={{
                textAlign: 'center',
                padding: 40,
                color: '#666',
                fontStyle: 'italic'
              }}>
                {capacityTestActive ? 'Waiting for results...' : 'No capacity test data yet'}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}

const panel = {
  background: "rgba(20,20,26,0.92)",
  border: "1px solid rgba(255,255,255,0.1)",
  borderRadius: 16,
  padding: 16,
  marginTop: 16,
};

const panelHeader = {
  display: "flex",
  alignItems: "center",
  cursor: "pointer",
  gap: 6,
};
