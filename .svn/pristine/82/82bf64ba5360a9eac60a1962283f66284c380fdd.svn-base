html, body, #root {
  height: 100%;
  margin: 0;
  padding: 0;
}

.app-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  align-items: center;
  background-color: #f0f0f0;
  height: 100%; /* has to be here for sandbox */
}

header {
  padding: 20px;
  font-size: 24px;
  font-weight: bold;
}

.sandbox-container {
  width: 66%;
  height: 80%;
  border: 1px solid #ccc;
  border-radius: 8px;
  overflow: hidden;
  background-color: rgb(30, 30, 30);
  display: flex;
}
