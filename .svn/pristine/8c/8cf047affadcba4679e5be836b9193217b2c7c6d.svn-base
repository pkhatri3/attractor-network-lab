import React, { useState, useContext, useEffect, useRef } from "react";
import { GraphContext } from "../GraphContext";
import { LearningContext } from "../LearningContext";
import StatePicker from "./StatePicker";
import { useNavigate, Link } from "react-router-dom";
import {LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer} from 'recharts';

const API_URL = import.meta.env.VITE_API_URL;

// Creating W, complicated function; lots of comments :)
function WeightsCanvas({ matrix, size = 500, scaleFactor = 2 }) {
  const canvasRef = React.useRef();
  const [showNumbers, setShowNumbers] = React.useState(true);

  React.useEffect(() => {
    if (!matrix || !matrix.length || !matrix[0].length) return;

    const rows = matrix.length;
    const cols = matrix[0].length;

    const canvas = canvasRef.current;
    const ctx = canvas.getContext("2d");

    // CSS size
    const dispW = size;
    const dispH = size;

    // Backing resolution
    const sf = Math.max(1, scaleFactor || 1);
    const outW = Math.floor(dispW * sf);
    const outH = Math.floor(dispH * sf);

    // Set backing and CSS sizes
    canvas.width = outW;
    canvas.height = outH;
    canvas.style.width = `${dispW}px`;
    canvas.style.height = `${dispH}px`;

    // Clear
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, outW, outH);

    // Compute color range (sample if too big)
    let min = Infinity, max = -Infinity;
    const total = rows * cols;
    if (total <= 200_000) {
      for (let r = 0; r < rows; r++) {
        const row = matrix[r];
        for (let c = 0; c < cols; c++) {
          const v = row[c];
          if (v < min) min = v;
          if (v > max) max = v;
        }
      }
    } else {
      const samples = Math.min(100_000, total);
      for (let i = 0; i < samples; i++) {
        const r = (i * 9301 + 49297) % rows;
        const c = (i * 23333 + 777) % cols;
        const v = matrix[r][c];
        if (v < min) min = v;
        if (v > max) max = v;
      }
      if (!isFinite(min) || !isFinite(max)) { min = -1; max = 1; }
    }

    const getRGB = (v) => {
      if (v === 0) return [200, 200, 200];
      if (v > 0) {
        const norm = v / (max || 1);
        return [Math.round(200 + 55 * norm), Math.round(200 - 200 * norm), Math.round(200 - 200 * norm)];
      } else {
        const norm = v / (min || -1);
        return [Math.round(200 - 200 * norm), Math.round(200 - 200 * norm), Math.round(200 + 55 * norm)];
      }
    };

    // Create ImageData at backing resolution (IMPORTANT!)
    const img = ctx.createImageData(outW, outH);
    const data = img.data;

    // Fill image
    let p = 0;
    for (let y = 0; y < outH; y++) {
      const rIdx = Math.floor((y * rows) / outH);
      const row = matrix[rIdx];
      for (let x = 0; x < outW; x++) {
        const cIdx = Math.floor((x * cols) / outW);
        const v = row[cIdx];
        const [R, G, B] = getRGB(v);
        data[p++] = R;
        data[p++] = G;
        data[p++] = B;
        data[p++] = 255;
      }
    }
    ctx.putImageData(img, 0, 0);

    const cellW_px = outW / cols;
    const cellH_px = outH / rows;

    // Draw grid only when cheap
    if (rows <= 100 && cols <= 100 && cellW_px >= 12 && cellH_px >= 12) {
      ctx.strokeStyle = "rgba(0,0,0,0.35)";
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let r = 1; r < rows; r++) {
        const y = Math.round(r * cellH_px) + 0.5;
        ctx.moveTo(0, y); ctx.lineTo(outW, y);
      }
      for (let c = 1; c < cols; c++) {
        const x = Math.round(c * cellW_px) + 0.5;
        ctx.moveTo(x, 0); ctx.lineTo(x, outH);
      }
      ctx.stroke();
    }

    // Numbers only when feasible
    const canDrawNumbers =
      showNumbers && rows <= 50 && cols <= 50 && cellW_px >= 24 && cellH_px >= 24;

    if (canDrawNumbers) {
      ctx.fillStyle = "#000";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      const fontPx = Math.max(10, Math.floor(cellH_px * 0.4));
      ctx.font = `${fontPx}px monospace`;
      for (let r = 0; r < rows; r++) {
        const row = matrix[r];
        for (let c = 0; c < cols; c++) {
          const val = row[c];
          const cx = c * cellW_px + cellW_px / 2;
          const cy = r * cellH_px + cellH_px / 2;
          ctx.fillText(
            (typeof val === "number" ? val : Number(val)).toFixed(1),
            cx, cy
          );
        }
      }
    }
  }, [matrix, size, scaleFactor, showNumbers]);

  const downloadAsPNG = () => {
    const url = canvasRef.current.toDataURL("image/png");
    const a = document.createElement("a");
    a.href = url;
    a.download = "weights.png";
    a.click();
  };

  const downloadAsJSON = () => {
    const blob = new Blob([JSON.stringify(matrix)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "weights.json";
    a.click();
    URL.revokeObjectURL(url);
  };

  return (
    <div style={{ textAlign: "center" }}>
      <canvas
        ref={canvasRef}
        style={{ border: "1px solid #444", borderRadius: 8 }}
      />
      <div style={{ marginTop: 10, display: "flex", justifyContent: "center", gap: 8, flexWrap: "wrap" }}>
        <button onClick={downloadAsPNG}>Download PNG</button>
        <button onClick={downloadAsJSON}>Download JSON</button>
        {matrix && matrix.length * matrix[0].length < 10_000 && (
          <button onClick={() => setShowNumbers(v => !v)}>
            {showNumbers ? "Hide Numbers" : "Show Numbers"}
          </button>
        )}
      </div>
    </div>
  );
}

export default function SimulationPhase() {
  const navigate = useNavigate();
  const { network } = useContext(GraphContext);
  const { 
    WHist, 
    memories,
    capacityTestActive,
    capacityResults,
    capacityNoiseLevel
  } = useContext(LearningContext);
  console.log(memories);

  const neuronCount = Array.isArray(network?.C) ? network.C.length : 0;
  const [gridCols, setGridCols] = useState(neuronCount);

  const [inputMode, setInputMode] = useState("text");
  const [Atext, setAtext] = useState("");
  const [Avec, setAvec] = useState([]);

  const [AHist, setAHist] = useState([]);
  const [energyHist, setEnergyHist] = useState([]);
  const [iter, setIter] = useState(0);
  const [error, setError] = useState(null);
  const [eventSource, setEventSource] = useState(null);
  const abortRef = useRef(null);
  const [initialA, setInitialA] = useState(null);
  const [isSimulating, setIsSimulating] = useState(false);
  const [showW, setShowW] = useState(false);
  const [showMemories, setShowMemories] = useState(false);

  function parseA(str) {
    try {
      const p = JSON.parse(str);
      if (Array.isArray(p) && p.length === neuronCount) {
        return p.map((v) => (v === 1 ? 1 : -1));
      }
    } catch {}
    return [];
  }

  function handleTextChange(str) {
    setAtext(str);
    const parsed = parseA(str);
    if (parsed.length === neuronCount) setAvec(parsed);
  }

  function stopSimulation() {
    if (abortRef.current) {
      abortRef.current.abort();
      abortRef.current = null;
    }
    if (eventSource) {
      eventSource.close();
      setEventSource(null);
    }
    setIsSimulating(false);
  }

  useEffect(() => () => stopSimulation(), []);

  const canSimulate =
    neuronCount > 0 && Avec.length === neuronCount && WHist?.length;

  async function onStartSimulation() {
    if (!canSimulate) return;
    setError(null);
    setAHist([]);
    setEnergyHist([]);
    setIter(0);
    stopSimulation();
    setInitialA([...Avec]);
    setIsSimulating(true);

    try {
      const controller = new AbortController();
      abortRef.current = controller;

      const res = await fetch(`${API_URL}/simulate_stream`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          A: Avec,
          W: WHist[WHist.length - 1],
          max_iters: 200,
        }),
        signal: controller.signal,
      });

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = "";

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });

        let parts = buffer.split("\n\n");
        buffer = parts.pop();

        for (const part of parts) {
          const line = part.trim();
          if (line.startsWith("data:")) {
            const payload = line.slice(5).trim();
            if (!payload) continue;
            let data;
            try {
              data = JSON.parse(payload);
            } catch {
              continue;
            }
            if (data.done) return;
            if (data.A) {
              setAHist((prev) => {
                // if this state is the same as the last one, don't append
                if (prev.length > 0 && JSON.stringify(prev[prev.length - 1]) === JSON.stringify(data.A)) {
                  return prev;
                }
                const next = [...prev, data.A];
                setIter(next.length - 1);

                // live update textarea
                if (inputMode === "text") {
                  setAtext(JSON.stringify(data.A));
                  setAvec(data.A);
                }

                return next;
              });

              if (data.E !== undefined) {
                setEnergyHist((prev) => {
                  if (prev.length > 0 && prev[prev.length - 1] === data.E) return prev;
                  return [...prev, data.E];
                });
              }
            }
          }
        }
      }
    } catch (e) {
      if (e.name !== "AbortError") setError(e.message);
    }
  }

  // Reset handler
  function handleReset() {
    if (initialA) {
      setAvec(initialA);
      setAtext(JSON.stringify(initialA));
      setAHist([]);
      setEnergyHist([]);
      setIter(0);
      stopSimulation();
    }
  }


  const Row = ({ vec }) => {
    if (!vec) return null;
    return (
      <div
        style={{
          display: "grid",
          gridTemplateColumns: `repeat(${gridCols}, 32px)`,
          gap: 4,
        }}
      >
        {vec.map((v, idx) => (
          <div
            key={idx}
            style={{
              width: 32,
              height: 32,
              borderRadius: 6,
              border: "1px solid rgba(255,255,255,0.15)",
              background:
                v === 1 ? "rgba(255,255,255,0.2)" : "rgba(255,255,255,0.06)",
              color: "#eaf4ff",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              fontFamily: "monospace",
              fontSize: 12,
              userSelect: "none",
            }}
            title={v === 1 ? "+1" : "-1"}
          >
            {v}
          </div>
        ))}
      </div>
    );
  };

  const finalW = WHist && WHist.length > 0 ? WHist[WHist.length - 1] : null;

  // Parse memories string (if provided) into an array for display
  let parsedMems = [];
  try {
    if (typeof memories === "string") {
      const maybe = JSON.parse(memories);
      if (Array.isArray(maybe)) parsedMems = maybe;
    } else if (Array.isArray(memories)) {
      parsedMems = memories;
    }
  } catch {
    // Keep empty on parse failure
  }

  return (
    <div
      style={{
        minHeight: "100vh",
        width: "100%",
        background: "#0f141a",
        color: "#eaf4ff",
        display: "flex",
        flexDirection: "column",
        padding: 20,
        overflowX: "hidden",
      }}
    >
      <Link
        to="/learning"
        style={{
          position: "absolute",
          top: 20,
          left: 20,
          padding: "10px 12px",
          borderRadius: 12,
          border: "1px solid rgba(255,255,255,0.12)",
          background: "#1a6fd6",
          color: "#eaf4ff",
          textDecoration: "none",
          cursor: "pointer",
          boxShadow: "0 8px 24px rgba(0,0,0,0.35)",
          backdropFilter: "blur(8px)",
          fontWeight: 600,
          display: "inline-flex",
          alignItems: "center",
          whiteSpace: "nowrap",
        }}
      >
        Back to Learning
      </Link>

      <div style={{ display: "flex", gap: 20, alignItems: "flex-start", maxWidth: "100%", height: "100%" }}>

        {/* Left Side */}
<div
  style={{
    flex: "0 0 auto",
    display: "flex",
    flexDirection: "column",
    gap: 16,
    width: "49%",
    marginTop: "5%",
  }}
>
  <div
    style={{
      background: "rgba(20,20,26,0.92)",
      border: "1px solid rgba(255,255,255,0.1)",
      borderRadius: 16,
      padding: 20,
      width: "100%",
      minHeight: "300px",
      display: "flex",
      flexDirection: "row",
      gap: 20,
    }}
  >
    <div
      style={{
        display: "flex",
        flexDirection: "column",
        gap: 12,
        width: "160px",
        flexShrink: 0,
      }}
    >
      <div style={{ display: "flex", gap: 4 }}>
        <button
          onClick={() => setInputMode("text")}
          style={{
            flex: 1,
            padding: "6px 8px",
            borderRadius: 6,
            border:
              inputMode === "text"
                ? "2px solid #1a6fd6"
                : "1px solid #ccc",
            background: inputMode === "text" ? "#1a6fd6" : "transparent",
            color: inputMode === "text" ? "#fff" : "#eaf4ff",
            cursor: "pointer",
            fontSize: 12,
            fontWeight: 600,
          }}
        >
          Text
        </button>
        <button
          onClick={() => setInputMode("matrix")}
          style={{
            flex: 1,
            padding: "6px 8px",
            borderRadius: 6,
            border:
              inputMode === "matrix"
                ? "2px solid #1a6fd6"
                : "1px solid #ccc",
            background: inputMode === "matrix" ? "#1a6fd6" : "transparent",
            color: inputMode === "matrix" ? "#fff" : "#eaf4ff",
            cursor: "pointer",
            fontSize: 12,
            fontWeight: 600,
          }}
        >
          Matrix
        </button>
      </div>

<div style={{ display: "flex", flexDirection: "column", gap: 8, marginTop: 12 }}>
  <button
    onClick={onStartSimulation}
    disabled={!canSimulate || isSimulating}
    style={{
      padding: "8px",
      borderRadius: 8,
      border: "1px solid rgba(255,255,255,0.12)",
      background: canSimulate && !isSimulating ? "#1a6fd6" : "#555",
      color: "#eaf4ff",
      cursor: canSimulate && !isSimulating ? "pointer" : "not-allowed",
      fontWeight: 600,
      fontSize: 13,
    }}
  >
    Start
  </button>

  <button
    onClick={handleReset}
    disabled={!isSimulating}
    style={{
      padding: "8px",
      borderRadius: 8,
      border: "1px solid rgba(255,255,255,0.12)",
      background: isSimulating ? "#1a6fd6" : "#555",
      color: "#eaf4ff",
      cursor: isSimulating ? "pointer" : "not-allowed",
      fontWeight: 600,
      fontSize: 13,
    }}
  >
    Reset
  </button>
</div>
</div>


    <div
      style={{
        flex: 1,
        display: "flex",
        flexDirection: "column",
        justifyContent: "center",
        alignItems: "center",
      }}
    >
      {inputMode === "text" ? (
        <div
          style={{
            width: "100%",
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
          }}
        >
          <textarea
            value={Atext}
            onChange={(e) => handleTextChange(e.target.value)}
            rows={6}
            disabled={isSimulating}
            style={{
              width: "100%",
              padding: 8,
              borderRadius: 10,
              background: "rgba(255,255,255,0.06)",
              color: "#eaf4ff",
              border: "1px solid rgba(255,255,255,0.12)",
              fontFamily: "monospace",
              opacity: isSimulating ? 0.85 : 1,
            }}
            placeholder={`Enter A like: [1, -1, 1, ...] with ${neuronCount} entries`}
          />
          <div
            style={{
              marginTop: 8,
              fontSize: 13,
              color: isSimulating ? "#aaa" : "transparent",
              fontWeight: 500,
              textAlign: "center",
              minHeight: "1em",
            }}
          >
            Iteration {iter}
          </div>
        </div>
      ) : (
        <StatePicker
          neuronCount={neuronCount}
          approxContainerWidth={480}
          initialState={Avec}
          externalState={isSimulating ? AHist[iter] : null}
          disabled={isSimulating}
          iteration={isSimulating ? iter : null}
          onStateChange={(newState, layout) => {
            if (!isSimulating) {
              setAvec(newState);
              setAtext(JSON.stringify(newState));
              setGridCols(layout?.cols || neuronCount);
            }
          }}
        />
      )}
    </div>
  </div>

  {error && <div style={{ color: "tomato" }}>{error}</div>}
</div>


        {/* Right side */}
        <div
          style={{
            flex: "0 0 auto",
            background: "rgba(20,20,26,0.92)",
            border: "1px solid rgba(255,255,255,0.1)",
            borderRadius: 16,
            padding: 20,
            overflowY: "auto",
            marginLeft: "3%",
            width: "40%",
            marginTop: "5%",
          }}
        >
          <div
            style={{
              background: "rgba(20,20,26,0.92)",
              border: "1px solid rgba(255,255,255,0.1)",
              borderRadius: 16,
              padding: 16,
              marginTop: 16,
            }}
          >
            <div
              style={{
                display: "flex",
                alignItems: "center",
                cursor: "pointer",
                gap: 6,
              }}
              onClick={() => setShowW((prev) => !prev)}
            >
              <span
                style={{
                  transform: showW ? "rotate(90deg)" : "rotate(0deg)",
                  transition: "0.2s",
                  display: "inline-block",
                }}
              >
                ▶
              </span>
              <h3 style={{ margin: 0 }}>W</h3>
            </div>

            <div style={{ display: showW ? "block" : "none", marginTop: 12 }}>
              {finalW ? (
                <WeightsCanvas matrix={finalW} size={400} />
              ) : (
                <p>No weights available yet.</p>
              )}
            </div>
          </div>

          <div
            style={{
              background: "rgba(20,20,26,0.92)",
              border: "1px solid rgba(255,255,255,0.1)",
              borderRadius: 16,
              padding: 16,
              marginTop: 16,
            }}
          >
            <div
              style={{
                display: "flex",
                alignItems: "center",
                cursor: "pointer",
                gap: 6,
              }}
              onClick={() => setShowMemories((prev) => !prev)}
            >
              <span
                style={{
                  transform: showMemories ? "rotate(90deg)" : "rotate(0deg)",
                  transition: "0.2s",
                  display: "inline-block",
                }}
              >
                ▶
              </span>
              <h3 style={{ margin: 0 }}>Memories</h3>
            </div>

            {showMemories && (
              <div style={{ marginTop: 12 }}>
                {parsedMems && parsedMems.length ? (
                  <div
                    style={{
                      background: "rgba(255,255,255,0.05)",
                      border: "1px solid rgba(255,255,255,0.1)",
                      borderRadius: 8,
                      padding: 12,
                      fontFamily: "monospace",
                      fontSize: 12,
                      whiteSpace: "pre-wrap",
                      wordBreak: "break-word",
                      overflowWrap: "anywhere",
                      maxHeight: "200px",
                      overflowY: "auto",
                    }}
                  >
                    {parsedMems.map((mem, idx) => (
                      <div key={idx}>
                        #{idx + 1}: {JSON.stringify(mem)}
                      </div>
                    ))}
                  </div>
                ) : (
                  <p style={{ color: "#aaa" }}>No memories available.</p>
                )}
              </div>
            )}
          </div>


          <div style={{
            marginTop: 30,
            padding: 20,
            backgroundColor: "rgba(20,20,26,0.92)",
            borderRadius: 16,
            border: "1px solid rgba(255,255,255,0.1)"
          }}>
            <h3 style={{ marginTop: 0, marginBottom: 15, color: "#fff" }}>
              Network Energy
            </h3>
            {energyHist.length > 0 ? (
              <ResponsiveContainer width="100%" height={250}>
                <LineChart data={energyHist.map((E, t) => ({ t, E }))}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#333" />
                  <XAxis 
                    dataKey="t" 
                    label={{ value: 'Timestep', position: 'insideBottom', offset: -5, fill: '#999' }}
                    stroke="#666"
                    tick={{ fill: '#999' }}
                  />
                  <YAxis 
                    label={{ value: 'Energy', angle: -90, position: 'insideLeft', fill: '#999' }}
                    stroke="#666"
                    tick={{ fill: '#999' }}
                  />
                  <Tooltip 
                    contentStyle={{ backgroundColor: '#2a2a2a', border: '1px solid #444' }}
                    labelStyle={{ color: '#fff' }}
                    itemStyle={{ color: '#1a6fd6' }}
                  />
                  <Line 
                    type="monotone" 
                    dataKey="E" 
                    stroke="#1a6fd6" 
                    strokeWidth={2}
                    dot={false}
                    isAnimationActive={false}
                  />
                </LineChart>
              </ResponsiveContainer>
            ) : (
              <div style={{ 
                textAlign: 'center', 
                padding: 40, 
                color: '#666',
                fontStyle: 'italic' 
              }}>
                Run simulation to see energy evolution
              </div>
            )}

            {energyHist.length > 0 && (
              <div style={{ marginTop: 10, fontSize: 14, color: '#999' }}>
                Current Energy: <strong style={{ color: '#1a6fd6' }}>
                  {energyHist[energyHist.length - 1]?.toFixed(3)}
                </strong>
                {" | "}
                Min: {Math.min(...energyHist).toFixed(3)}
                {" | "}
                Max: {Math.max(...energyHist).toFixed(3)}
              </div>
            )}
          </div>

          
          {(capacityTestActive || capacityResults) && (
            <div style={{
              marginTop: 30,
              padding: 20,
              backgroundColor: "rgba(20,20,26,0.92)",
              borderRadius: 16,
              border: "1px solid rgba(255,255,255,0.1)"
            }}>
              <h3 style={{ marginTop: 0, marginBottom: 10, color: "#eaf4ff" }}>
                Memory Capacity Test
                {capacityTestActive && (
                  <span style={{ 
                    marginLeft: 12, 
                    fontSize: 14, 
                    fontWeight: 400,
                    color: "#eaf4ff",
                    animation: "pulse 1.5s infinite"
                  }}>
                    Running...
                  </span>
                )}
              </h3>
              
              <div style={{ fontSize: 12, color: '#ccc', marginBottom: 15 }}>
                Noise Level: {(capacityNoiseLevel * 100).toFixed(0)}%
              </div>

              {capacityResults && capacityResults.length > 0 ? (
                <>
                  <ResponsiveContainer width="100%" height={300}>
                    <LineChart data={capacityResults}>
                      <CartesianGrid strokeDasharray="3 3" stroke="#333" />
                      <XAxis 
                        dataKey="num_patterns" 
                        label={{ value: 'Number of Patterns Stored', position: 'insideBottom', offset: -5, fill: '#999' }}
                        stroke="#666"
                        tick={{ fill: '#999' }}
                      />
                      <YAxis 
                        domain={[0, 'dataMax']}
                        allowDecimals={false}
                        label={{ value: 'Memories Recalled', angle: -90, position: 'insideLeft', fill: '#999' }}
                        stroke="#666"
                        tick={{ fill: '#999' }}
                      />
                      <Tooltip 
                        contentStyle={{ backgroundColor: '#2a2a2a', border: '1px solid #444' }}
                        labelStyle={{ color: '#fff' }}
                        itemStyle={{ color: '#1a6fd6' }}
                        formatter={(value, name) => {
                          if (name === 'success_count') return [value, 'Recalled'];
                          return [value, name];
                        }}
                      />
                      <Line 
                        type="monotone" 
                        dataKey="success_count" 
                        stroke="#1a6fd6" 
                        strokeWidth={3}
                        dot={{ fill: '#1a6fd6', r: 4 }}
                        isAnimationActive={false}
                      />
                    </LineChart>
                  </ResponsiveContainer>

                  

                  {!capacityTestActive && capacityResults.length > 0 && (
                    <div style={{ 
                      marginTop: 15, 
                      padding: 12, 
                      background: 'rgba(26,111,214,0.12)',
                      border: '1px solid rgba(26,111,214,0.4)',
                      borderRadius: 8,
                      fontSize: 13,
                      color: '#1a6fd6'
                    }}>
                      ✓ Test complete! Tested {capacityResults[capacityResults.length - 1]?.num_patterns} patterns total.
                    </div>
                  )}
                </>
              ) : (
                <div style={{ 
                  textAlign: 'center', 
                  padding: 40, 
                  color: '#666',
                  fontStyle: 'italic' 
                }}>
                  {capacityTestActive ? 'Waiting for results...' : 'No capacity test data yet'}
                </div>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
