html, body, #root {
  height: 100%;
  margin: 0;
  padding: 0;
}

.sandbox-container {
  width: 100%;
  height: 100%;
  background: #0f141a;
  overflow: hidden;
  position: relative;
}

.sandbox-container.mode-draw,
.sandbox-container.mode-draw canvas {
  cursor: crosshair !important;
}

.sandbox-container.mode-delete,
.sandbox-container.mode-delete canvas {
  cursor: not-allowed !important;
}

.sandbox-container:not(.mode-draw):not(.mode-delete),
.sandbox-container:not(.mode-draw):not(.mode-delete) canvas {
  cursor: default !important;
}

button {
  transition: background 0.15s ease, transform 0.1s ease;
}

button:active {
  transform: scale(0.97);
}

.tools-menu {
  transition: opacity 0.2s ease, transform 0.2s ease;
}
