import React, { useState, useRef, useContext } from "react";
import { Link } from "react-router-dom";
import { GraphContext } from "../GraphContext";
import GraphCanvas from "../components/GraphCanvas";
import MenuButton from "../components/MenuButton";
import ToolsMenu from "../components/ToolsMenu";
import "../styles/Construction.css";
import { serializeGraph } from "../utils/ioUtils";

export default function Construction() {
  const { setNetwork } = useContext(GraphContext);

  const [menuOpen, setMenuOpen] = useState(true);
  const [gridMode, setGridMode] = useState(false);
  const [mode, setMode] = useState("idle");

  // --- New: separate template and object type states ---
  const [objectType, setObjectType] = useState("node"); // "node" or "template"
  const [selectedTemplate, setSelectedTemplate] = useState("Hopfield Connectivity");
  const [customTemplates, setCustomTemplates] = useState([]);
  // --- Template configuration states ---
  const [hopfieldCount, setHopfieldCount] = useState("12");
  const [rectRows, setRectRows] = useState("3");
  const [rectCols, setRectCols] = useState("4");
  const [hexRows, setHexRows] = useState("4");
  const [hexCols, setHexCols] = useState("6");

  const clearGraphFnRef = useRef(null);
  const graphRefs = useRef({}); // { graphRef, sigmaRef }

  const handleClearAll = () => {
    if (clearGraphFnRef.current) clearGraphFnRef.current();
  };

  const handleGoToLearning = () => {
    const graph = graphRefs.current.graphRef?.current;
    if (graph) setNetwork(serializeGraph(graph));
  };

  return (
    <div className="sandbox-container">
      {/* --- Menu Toggle --- */}
      <MenuButton onClick={() => setMenuOpen((o) => !o)} isOpen={menuOpen} />

      {/* --- Grid Toggle --- */}
      <button
        onClick={() => setGridMode((g) => !g)}
        aria-pressed={gridMode}
        style={{
          position: "absolute",
          top: 12,
          right: 12,
          zIndex: 20,
          padding: "10px 12px",
          borderRadius: 12,
          border: "1px solid rgba(255,255,255,0.12)",
          background: gridMode ? "#1a6fd6" : "rgba(20,20,26,0.75)",
          color: "#eaf4ff",
          cursor: "pointer",
          boxShadow: "0 8px 24px rgba(0,0,0,0.35)",
          backdropFilter: "blur(8px)",
        }}
      >
        {gridMode ? "Switch to freeform" : "Switch to grid"}
      </button>

      {/* --- Transition to Learning Phase --- */}
      <Link
        to="/learning"
        onClick={handleGoToLearning}
        style={{
          position: "absolute",
          top: 60,
          right: 12,
          zIndex: 20,
          padding: "10px 12px",
          borderRadius: 12,
          border: "1px solid rgba(255,255,255,0.12)",
          background: "#1a6fd6",
          color: "#eaf4ff",
          textDecoration: "none",
          cursor: "pointer",
          fontWeight: 600,
          boxShadow: "0 8px 24px rgba(0,0,0,0.35)",
          backdropFilter: "blur(8px)",
        }}
      >
        Go to Learning →
      </Link>

      {/* --- Tools Menu --- */}
      <ToolsMenu
        open={menuOpen}
        mode={mode}
        setMode={setMode}
        hopfieldCount={hopfieldCount}
        setHopfieldCount={setHopfieldCount}
        rectRows={rectRows}
        setRectRows={setRectRows}
        rectCols={rectCols}
        setRectCols={setRectCols}
        hexRows={hexRows}
        setHexRows={setHexRows}
        hexCols={hexCols}
        setHexCols={setHexCols}
        onClearAll={handleClearAll}
        graphRefs={graphRefs}
        setNetwork={setNetwork}
        objectType={objectType}
        setObjectType={setObjectType}
        selectedTemplate={selectedTemplate}
        setSelectedTemplate={setSelectedTemplate}
        customTemplates={customTemplates}
        setCustomTemplates={setCustomTemplates}
      />

      {/* --- Main Graph Canvas --- */}
      <GraphCanvas
        mode={mode}
        gridMode={gridMode}
        nodeSizePreset={"medium"}
        hopfieldCount={hopfieldCount}
        rectRows={rectRows}
        rectCols={rectCols}
        hexRows={hexRows}
        hexCols={hexCols}
        objectType={objectType}
        selectedTemplate={selectedTemplate}
        customTemplates={customTemplates}
        onClearGraph={(fn) => (clearGraphFnRef.current = fn)}
        onGraphRefs={(refs) => (graphRefs.current = refs)}
      />
    </div>
  );
}
