import React, { useState, useContext, useEffect } from "react";
import { GraphContext } from "../GraphContext";
import { LearningContext } from "../LearningContext";
import { Link, useNavigate } from "react-router-dom";
import LayoutPicker from "./LayoutPicker";
import MemoryImporter from "./MemoryImporter";

window.__API_URL__ = import.meta.env.VITE_API_URL;
const API_URL = import.meta.env.VITE_API_URL;

export default function LearningPhase() {
  const navigate = useNavigate();
  const { network } = useContext(GraphContext);
  const {
    memories, setMemories,
    rule, setRule,
    WHist, setWHist,
    learningComplete, setLearningComplete,
    capacityNoiseLevel, setCapacityNoiseLevel,
    setCapacityTestActive,
    setCapacityResults
  } = useContext(LearningContext);

  const [learningRate, setLearningRate] = useState(0.25);
  const [scale, setScale] = useState(1.0);
  const [currentStep, setCurrentStep] = useState(0);
  const [error, setError] = useState(null);
  const [layoutChoice, setLayoutChoice] = useState(null);
  const [memList, setMemList] = useState([]);
  const [pickerKey, setPickerKey] = useState(0);
  const [pickerOpen, setPickerOpen] = useState(false);


  useEffect(() => {
    if (WHist && WHist.length > 0) {
      setCurrentStep(WHist.length - 1);
    }
  }, [WHist]);

  function parseMemoriesSafe(str) {
    try {
      const p = JSON.parse(str);
      return Array.isArray(p) ? p : [];
    } catch {
      return [];
    }
  }

  // See LearningContext.jsx function for more detailed comments (same func is over there)
  function WeightsCanvas({ matrix, size = 500, scaleFactor = 2 }) {
    const canvasRef = React.useRef();
    const [showNumbers, setShowNumbers] = React.useState(true);

    React.useEffect(() => {
      if (!matrix || !matrix.length || !matrix[0].length) return;

      const rows = matrix.length;
      const cols = matrix[0].length;

      const canvas = canvasRef.current;
      const ctx = canvas.getContext("2d");

      const dispW = size;
      const dispH = size;

      const sf = Math.max(1, scaleFactor || 1);
      const outW = Math.floor(dispW * sf);
      const outH = Math.floor(dispH * sf);

      canvas.width = outW;
      canvas.height = outH;
      canvas.style.width = `${dispW}px`;
      canvas.style.height = `${dispH}px`;

      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, outW, outH);

      let min = Infinity, max = -Infinity;
      const total = rows * cols;
      if (total <= 200_000) {
        for (let r = 0; r < rows; r++) {
          const row = matrix[r];
          for (let c = 0; c < cols; c++) {
            const v = row[c];
            if (v < min) min = v;
            if (v > max) max = v;
          }
        }
      } else {
        const samples = Math.min(100_000, total);
        for (let i = 0; i < samples; i++) {
          const r = (i * 9301 + 49297) % rows;
          const c = (i * 23333 + 777) % cols;
          const v = matrix[r][c];
          if (v < min) min = v;
          if (v > max) max = v;
        }
        if (!isFinite(min) || !isFinite(max)) { min = -1; max = 1; }
      }

      const getRGB = (v) => {
        if (v === 0) return [200, 200, 200];
        if (v > 0) {
          const norm = v / (max || 1);
          return [Math.round(200 + 55 * norm), Math.round(200 - 200 * norm), Math.round(200 - 200 * norm)];
        } else {
          const norm = v / (min || -1);
          return [Math.round(200 - 200 * norm), Math.round(200 - 200 * norm), Math.round(200 + 55 * norm)];
        }
      };

      const img = ctx.createImageData(outW, outH);
      const data = img.data;

      let p = 0;
      for (let y = 0; y < outH; y++) {
        const rIdx = Math.floor((y * rows) / outH);
        const row = matrix[rIdx];
        for (let x = 0; x < outW; x++) {
          const cIdx = Math.floor((x * cols) / outW);
          const v = row[cIdx];
          const [R, G, B] = getRGB(v);
          data[p++] = R;
          data[p++] = G;
          data[p++] = B;
          data[p++] = 255;
        }
      }
      ctx.putImageData(img, 0, 0);

      const cellW_px = outW / cols;
      const cellH_px = outH / rows;

      if (rows <= 100 && cols <= 100 && cellW_px >= 12 && cellH_px >= 12) {
        ctx.strokeStyle = "rgba(0,0,0,0.35)";
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (let r = 1; r < rows; r++) {
          const y = Math.round(r * cellH_px) + 0.5;
          ctx.moveTo(0, y); ctx.lineTo(outW, y);
        }
        for (let c = 1; c < cols; c++) {
          const x = Math.round(c * cellW_px) + 0.5;
          ctx.moveTo(x, 0); ctx.lineTo(x, outH);
        }
        ctx.stroke();
      }

      const canDrawNumbers =
        showNumbers && rows <= 50 && cols <= 50 && cellW_px >= 24 && cellH_px >= 24;

      if (canDrawNumbers) {
        ctx.fillStyle = "#000";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        const fontPx = Math.max(10, Math.floor(cellH_px * 0.4));
        ctx.font = `${fontPx}px monospace`;
        for (let r = 0; r < rows; r++) {
          const row = matrix[r];
          for (let c = 0; c < cols; c++) {
            const val = row[c];
            const cx = c * cellW_px + cellW_px / 2;
            const cy = r * cellH_px + cellH_px / 2;
            ctx.fillText(
              (typeof val === "number" ? val : Number(val)).toFixed(1),
              cx, cy
            );
          }
        }
      }
    }, [matrix, size, scaleFactor, showNumbers]);

    const downloadAsPNG = () => {
      const url = canvasRef.current.toDataURL("image/png");
      const a = document.createElement("a");
      a.href = url;
      a.download = "weights.png";
      a.click();
    };

    const downloadAsJSON = () => {
      const blob = new Blob([JSON.stringify(matrix)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "weights.json";
      a.click();
      URL.revokeObjectURL(url);
    };

    return (
      <div style={{ textAlign: "center" }}>
        <canvas
          ref={canvasRef}
          style={{ border: "1px solid #444", borderRadius: 8 }}
        />
        <div style={{ marginTop: 10, display: "flex", justifyContent: "center", gap: 8, flexWrap: "wrap" }}>
          <button onClick={downloadAsPNG}>Download PNG</button>
          <button onClick={downloadAsJSON}>Download JSON</button>
          {matrix && matrix.length * matrix[0].length < 10_000 && (
            <button onClick={() => setShowNumbers(v => !v)}>
              {showNumbers ? "Hide Numbers" : "Show Numbers"}
            </button>
          )}
        </div>
      </div>
    );
  }

  const baseMemories = parseMemoriesSafe(memories);
  const N = Array.isArray(network?.C) ? network.C.length : 0;

  const neuronCount = (() => {
    if (Array.isArray(network?.C)) return network.C.length;
    try {
      const parsed = JSON.parse(memories);
      if (Array.isArray(parsed) && Array.isArray(parsed[0])) {
        return parsed[0].length;
      }
    } catch {}
    return 0;
  })();

  useEffect(() => {
    let parsed = [];
    try {
      const p = JSON.parse(memories);
      if (Array.isArray(p)) parsed = p;
    } catch {
      return;
    }
    const allMatch =
      neuronCount > 0 &&
      parsed.every((v) => Array.isArray(v) && v.length === neuronCount);
    if (!allMatch) return;
    const same = JSON.stringify(parsed) === JSON.stringify(memList);
    if (!same) {
      setMemList(parsed);
      setPickerKey((k) => k + 1);
    }
  }, [memories, neuronCount, memList]);

  const initialMemoriesMemo = React.useMemo(() => {
    try {
      const p = JSON.parse(memories);
      return Array.isArray(p) ? p : [];
    } catch {
      return [];
    }
  }, [memories]);

  // Reset scale to 1 if not using decay
  useEffect(() => {
    if (rule !== "decay") setScale(1.0);
  }, [rule]);

  const beginLearning = async () => {
    try {
      if (!network || !network.C) {
        setError("No network available from Sandbox.");
        setLearningComplete(false);
        return;
      }
      if (!API_URL) {
        setError("VITE_API_URL is not set. Create frontend/.env.local and restart Vite.");
        setLearningComplete(false);
        return;
      }
      setError(null);

      const Nnet = Array.isArray(network?.C) ? network.C.length : 0;
      const source = (Array.isArray(memList) && memList.length > 0)
        ? memList
        : baseMemories; 

      if (!Array.isArray(source) || source.length === 0) {
       setError("No memories loaded. Import a CSV or type memories first.");
       return;
      }
      const memWidth = Array.isArray(source[0]) ? source[0].length : 0;
      if (Nnet > 0 && memWidth !== Nnet) {

        setError(`Neuron count mismatch: CSV has ${memWidth}, network expects ${Nnet}. Adjust your grid/network or CSV and try again.`);
        return;
      }
     
      const effectiveMemories = source.map(row => row.map(v => (v === 1 ? 1 : -1)));

      const payload = {
        memories: effectiveMemories,
        C: network.C,
        learning_rate: learningRate,
        scale,
        rule,
        view_layout: layoutChoice ? { rows: layoutChoice.rows, cols: layoutChoice.cols } : null,
      };

      console.clear();
      console.log("API_URL runtime =", API_URL);
      console.log("Sending to:", `${API_URL}/learn`);
      console.log("Payload:", payload);
      console.log("Summary before POST:", {
        memoriesCount: effectiveMemories.length,
        neuronsPerMemory: effectiveMemories[0]?.length ?? 0,
        networkN: Nnet,
        });

      const res = await fetch(`${API_URL}/learn`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!res.ok) throw new Error(`Backend error: ${res.status}`);
      const data = await res.json();
      console.log("Response:", data);

      if (data.W_hist) {
        setWHist(data.W_hist);
        setCurrentStep(data.W_hist.length - 1);
        setLearningComplete(true);
      } else {
        setError("No weight matrices returned from backend.");
        setLearningComplete(false);
      }
    } catch (err) {
      console.error("Error during learning:", err);
      setError(err.message || "Learning failed.");
      setLearningComplete(false);
    }
  };

  const runCapacityTest = async () => {
    try {
      if (!network || !network.C) {
        setError("No network available from Sandbox.");
        return;
      }
      if (!API_URL) {
        setError("VITE_API_URL is not set.");
        return;
      }
      setError(null);

      const Nnet = Array.isArray(network?.C) ? network.C.length : 0;
      const source = (Array.isArray(memList) && memList.length > 0)
        ? memList
        : baseMemories;

      if (!Array.isArray(source) || source.length === 0) {
        setError("No memories loaded. Import memories first.");
        return;
      }
      
      if (source.length < 2) {
        setError("Need at least 2 memories to test capacity.");
        return;
      }

      const memWidth = Array.isArray(source[0]) ? source[0].length : 0;
      if (Nnet > 0 && memWidth !== Nnet) {
        setError(`Neuron count mismatch: CSV has ${memWidth}, network expects ${Nnet}.`);
        return;
      }

      const effectiveMemories = source.map(row => row.map(v => (v === 1 ? 1 : -1)));

      // Mark test as active and navigate to simulation page
      setCapacityTestActive(true);
      setCapacityResults(null);
      
      // Navigate immediately so user sees the simulation page
      navigate('/simulation');

      // Start the streaming test
      const payload = {
        memories: effectiveMemories,
        C: network.C,
        learning_rate: learningRate,
        scale,
        rule,
        noise_level: capacityNoiseLevel,
        max_iters: 50
      };

      const response = await fetch(`${API_URL}/memory_capacity_test`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!response.ok) throw new Error(`Backend error: ${response.status}`);

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let buffer = "";
      const results = [];

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split("\n");
        buffer = lines.pop() || "";

        for (const line of lines) {
          if (line.startsWith("data: ")) {
            const dataStr = line.slice(6);
            try {
              const parsed = JSON.parse(dataStr);
              if (parsed.done) {
                setCapacityTestActive(false);
                console.log("Capacity test complete!");
              } else if (parsed.error) {
                setError(parsed.error);
                setCapacityTestActive(false);
              } else if (parsed.num_patterns !== undefined) {
                results.push(parsed);
                setCapacityResults([...results]);
              }
            } catch (e) {
              console.error("Failed to parse SSE data:", e);
            }
          }
        }
      }
    } catch (err) {
      console.error("Error during capacity test:", err);
      setError(err.message || "Capacity test failed.");
      setCapacityTestActive(false);
    }
  };

  return (
    <div
      style={{
        minHeight: "100vh",
        width: "100%",
        background: "#0f141a",
        color: "#eaf4ff",
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        justifyContent: "flex-start",
        paddingTop: 40,
        paddingBottom: 40,
        position: "relative",
      }}
    >
      <h1 style={{ marginBottom: 24 }}>Learning Phase</h1>

      <Link
        to="/"
        style={{
          position: "absolute",
          top: 20,
          left: 20,
          padding: "10px 12px",
          borderRadius: 12,
          border: "1px solid rgba(255,255,255,0.12)",
          background: "#1a6fd6",
          color: "#eaf4ff",
          textDecoration: "none",
          cursor: "pointer",
          boxShadow: "0 8px 24px rgba(0,0,0,0.35)",
          backdropFilter: "blur(8px)",
          fontWeight: 600,
          display: "inline-flex",
          alignItems: "center",
          whiteSpace: "nowrap",
        }}
      >
        Back to Construction
      </Link>

      <Link
        to={learningComplete ? "/simulation" : "#"}
        style={{
          position: "absolute",
          top: 20,
          right: 20,
          padding: "10px 12px",
          borderRadius: 12,
          border: "1px solid rgba(255,255,255,0.12)",
          background: learningComplete ? "#1a6fd6" : "#555",
          color: "#eaf4ff",
          textDecoration: "none",
          cursor: learningComplete ? "pointer" : "not-allowed",
          opacity: learningComplete ? 1 : 0.5,
          fontWeight: 600,
          boxShadow: "0 8px 24px rgba(0,0,0,0.35)",
          backdropFilter: "blur(8px)",
        }}
        onClick={(e) => {
          if (!learningComplete) e.preventDefault();
        }}
      >
        Go to Simulation
      </Link>

      <div
        style={{
          display: "flex",
          justifyContent: "center",
          gap: 32,
          width: "90%",
          maxWidth: 1200,
        }}
      >
        {/* Input panel */}
        <div
          style={{
            flex: 1,
            background: "rgba(20,20,26,0.92)",
            border: "1px solid rgba(255,255,255,0.1)",
            borderRadius: 16,
            padding: 20,
            boxShadow: "0 10px 30px rgba(0,0,0,0.45)",
            backdropFilter: "blur(10px)",
            display: "flex",
            flexDirection: "column",
            gap: 16,
          }}
        >
          <div>
            <div style={{ fontSize: 12, opacity: 0.9, marginBottom: 4 }}>Input Memories:</div>
            <textarea
              value={memories ?? ""}
              onChange={(e) => setMemories(e.target.value)}
              rows={7}
              style={{
                width: "96%",
                padding: 8,
                borderRadius: 10,
                background: "rgba(255,255,255,0.06)",
                color: "#eaf4ff",
                border: "1px solid rgba(255,255,255,0.12)",
                fontFamily: "monospace",
              }}
            />
          </div>

          <div>
            <div style={{ fontSize: 12, opacity: 0.9, marginBottom: 4 }}>Learning Rate (μ):</div>
            <input
              type="number"
              step="0.01"
              value={learningRate}
              onChange={(e) => setLearningRate(parseFloat(e.target.value))}
              style={{
                width: "96%",
                padding: 8,
                borderRadius: 10,
                background: "rgba(255,255,255,0.06)",
                color: "#eaf4ff",
                border: "1px solid rgba(255,255,255,0.12)",
              }}
            />
          </div>

          <div style={{ marginTop: 12 }}>
            <div style={{ fontSize: 12, opacity: 0.9, marginBottom: 4 }}>Learning Rule:</div>
            <select
              value={rule}
              onChange={(e) => setRule(e.target.value)}
              style={{
                width: "100%",
                padding: 8,
                borderRadius: 10,
                background: "rgba(255,255,255,0.06)",
                color: "#eaf4ff",
                border: "1px solid rgba(255,255,255,0.12)",
              }}
            >
              <option style={{ color: "rgb(0,0,0)" }} value="standard">
                Standard
              </option>
              <option style={{ color: "rgb(0,0,0)" }} value="iterative">
                Iterative
              </option>
              <option style={{ color: "rgb(0,0,0)" }} value="decay">
                Decay
              </option>
            </select>
          </div>

          {rule === "decay" && (
            <div>
              <div style={{ fontSize: 12, opacity: 0.9, marginBottom: 4 }}>Scale:</div>
              <input
                type="number"
                step="0.1"
                value={scale}
                onChange={(e) => setScale(parseFloat(e.target.value))}
                style={{
                  width: "96%",
                  padding: 8,
                  borderRadius: 10,
                  background: "rgba(255,255,255,0.06)",
                  color: "#eaf4ff",
                  border: "1px solid rgba(255,255,255,0.12)",
                }}
              />
            </div>
          )}

          {neuronCount > 0 && (
            <div style={{ marginTop: 8 }}>
              <CollapsibleHeader
                open={pickerOpen}
                onToggle={() => setPickerOpen(o => !o)}
                layoutChoice={layoutChoice}
                neuronCount={neuronCount}
                memCount={memList.length}
              />

              <div
                style={{
                  maxHeight: pickerOpen ? "none" : 0,
                  overflow: pickerOpen ? "visible" : "hidden",
                  transition: "max-height 220ms ease, opacity 180ms ease",
                  opacity: pickerOpen ? 1 : 0,
                }}
                aria-hidden={!pickerOpen}
              >
                <div style={{ marginTop: 10 }}>
                  <LayoutPicker
                    key={pickerKey}
                    neuronCount={neuronCount}
                    value={layoutChoice}
                    onLayoutChange={setLayoutChoice}
                    approxContainerWidth={480}
                    initialMemories={initialMemoriesMemo}
                    onMemoriesChange={(list) => {
                      setMemList(list);
                      setMemories(JSON.stringify(list, null, 2)); 
                    }}
                  />
                </div>
              </div>
            </div>
          )}
          <MemoryImporter
            expectedN={neuronCount || undefined}
            onImportMemories={(parsed, mode) => {
              
              let next = parsed;
              if (mode === "append" && Array.isArray(memList) && memList.length > 0) {
                const w = memList[0].length;
                if (parsed[0]?.length !== w) {
                  
                  alert(
                    `Append failed: imported memories have width ${parsed[0]?.length}, existing set uses ${w}.`
                  );
                  return;
                }
                next = [...memList, ...parsed];
              }
              setMemList(next);
              setMemories(JSON.stringify(next, null, 2));
              setWHist(null);
              setCurrentStep(0);
              const N = next[0]?.length || 0;
              if (layoutChoice && (layoutChoice.rows * layoutChoice.cols - (layoutChoice.pad || 0)) !== N) {
                setLayoutChoice(null);
              }

              setPickerKey((k) => k + 1);
            }}
          />


          <button
            onClick={beginLearning}
            style={{
              padding: "10px 12px",
              borderRadius: 10,
              border: "1px solid rgba(255,255,255,0.12)",
              background: "#1a6fd6",
              color: "#eaf4ff",
              cursor: "pointer",
              fontWeight: 600,
            }}
          >
            Begin Learning
          </button>

          {/* Memory Capacity Test Section */}
          <div
            style={{
              marginTop: 24,
              padding: 16,
              borderRadius: 12,
              border: "1px solid rgba(255,255,255,0.12)",
              background: "rgba(255,255,255,0.06)",
            }}
          >
            <h3 style={{ margin: "0 0 12px 0", fontSize: 14, fontWeight: 600, color: "#eaf4ff" }}>
              Memory Capacity Test
            </h3>
            <p style={{ fontSize: 12, opacity: 0.8, marginBottom: 12, color: "#eaf4ff" }}>
              Test how well the network recalls patterns as more memories are added.
            </p>

            <div style={{ marginBottom: 12 }}>
              <div style={{ fontSize: 12, opacity: 0.9, marginBottom: 6 }}>
                Noise Level: {(capacityNoiseLevel * 100).toFixed(0)}%
              </div>
              <input
                type="range"
                min="0"
                max="0.5"
                step="0.05"
                value={capacityNoiseLevel}
                onChange={(e) => setCapacityNoiseLevel(parseFloat(e.target.value))}
                style={{ width: "100%" }}
              />
              <div
                style={{
                  display: "flex",
                  justifyContent: "space-between",
                  fontSize: 10,
                  opacity: 0.6,
                  marginTop: 2,
                }}
              >
                <span>0%</span>
                <span>25%</span>
                <span>50%</span>
              </div>
            </div>

            <button
              onClick={runCapacityTest}
              style={{
                width: "100%",
                padding: "10px 12px",
                borderRadius: 10,
                border: "1px solid rgba(255,255,255,0.12)",
                background: "#1a6fd6",
                color: "#eaf4ff",
                cursor: "pointer",
                fontWeight: 600,
              }}
            >
              Run Capacity Test
            </button>
          </div>

          {error && (
            <p style={{ color: "red", marginTop: 8, textAlign: "center" }}>{error}</p>
          )}
        </div>

        {/* Matrix panel */}
        <div
          style={{
            flex: 1,
            minHeight: 400,
            background: "rgba(20,20,26,0.92)",
            border: "1px solid rgba(255,255,255,0.1)",
            borderRadius: 16,
            padding: 20,
            boxShadow: "0 10px 30px rgba(0,0,0,0.45)",
            backdropFilter: "blur(10px)",
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
            justifyContent: "center",
          }}
        >
          {WHist ? (
            <>
              <h2 style={{ marginBottom: 12 }}>
                Weight Matrix W (Step {currentStep + 1}/{WHist.length})
              </h2>
              <WeightsCanvas matrix={WHist[currentStep]} size={500} />

              <div
                style={{
                  display: "flex",
                  justifyContent: "center",
                  gap: "24px",
                  marginTop: "10px",
                  fontSize: "14px",
                  alignItems: "center",
                }}
              >
                <div style={{ display: "flex", alignItems: "center", gap: "6px" }}>
                  <div style={{ width: 20, height: 20, background: "rgb(255,0,0)", borderRadius: 4 }} />
                  <span>= Max Value</span>
                </div>
                <div style={{ display: "flex", alignItems: "center", gap: "6px" }}>
                  <div style={{ width: 20, height: 20, background: "rgb(200,200,200)", border: "1px solid #ccc", borderRadius: 4 }} />
                  <span>= 0</span>
                </div>
                <div style={{ display: "flex", alignItems: "center", gap: "6px" }}>
                  <div style={{ width: 20, height: 20, background: "rgb(0,0,255)", borderRadius: 4 }} />
                  <span>= Min Value</span>
                </div>
              </div>

              <input
                type="range"
                min={0}
                max={WHist.length - 1}
                value={currentStep}
                onChange={(e) => setCurrentStep(parseInt(e.target.value))}
                style={{ width: "100%", marginTop: 16 }}
              />
            </>
          ) : (
            <div
              style={{
                width: 300,
                height: 300,
                border: "2px dashed rgba(255,255,255,0.2)",
                borderRadius: 12,
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                color: "rgba(255,255,255,0.5)",
              }}
            >
              Matrix will appear here after learning
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
function CollapsibleHeader({ open, onToggle, layoutChoice, neuronCount, memCount }) {
  const chev = open ? "▾" : "▸";
  const layoutSummary = layoutChoice
    ? `${layoutChoice.rows}×${layoutChoice.cols}${layoutChoice.pad ? ` (pad ${layoutChoice.pad})` : ""}`
    : `${neuronCount} nodes`;
  return (
    <button
      onClick={onToggle}
      aria-expanded={open}
      style={{
        width: "100%",
        display: "flex",
        alignItems: "center",
        justifyContent: "space-between",
        gap: 12,
        padding: "10px 12px",
        borderRadius: 10,
        border: "1px solid rgba(255,255,255,0.12)",
        background: "rgba(255,255,255,0.06)",
        color: "#eaf4ff",
        cursor: "pointer",
        fontWeight: 600,
      }}
    >
      <span style={{ display: "inline-flex", alignItems: "center", gap: 8 }}>
        <span style={{ fontSize: 14 }}>{chev}</span>
        Memories & Layout
      </span>
      <span style={{ opacity: 0.85, fontWeight: 500, fontSize: 12 }}>
        {memCount} {memCount === 1 ? "memory" : "memories"}
      </span>
    </button>
  );
}

