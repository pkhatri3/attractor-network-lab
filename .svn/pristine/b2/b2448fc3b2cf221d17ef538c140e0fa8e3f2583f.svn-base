
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
import numpy as np
from copy import deepcopy


from attractor import attractorNet, sgn  

app = FastAPI()

app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        "http://localhost:5175",
        "http://127.0.0.1:5175",
        "http://localhost:5174",     # vite may hop ports
        "http://127.0.0.1:5174",
    ],
    allow_credentials=True,
    allow_methods=["*"],             # important for preflight
    allow_headers=["*"],             # important for preflight (Content-Type, etc.)
)

AN = None
N_GLOBAL = None

class LearnPayload(BaseModel):
    memories: list[list[int]]  

class SimPayload(BaseModel):
    ainit: list[int]
    t_MAX: int = 30
    granularity: str = "sweep"

@app.post("/learn")
def learn(payload: LearnPayload):
    global AN, N_GLOBAL
    memories = payload.memories
    if len(memories) == 0:
        return {"ok": False, "error": "No memories provided."}

    
    M = len(memories)
    N = len(memories[0])
    data = np.array(memories).T  
    C = np.ones((N, N))
    AN = attractorNet(N, C, 0)
    AN.learn(data, N, M, "standard")
    N_GLOBAL = N
    return {"ok": True, "N": N, "M": M, "W": AN.W.tolist()}

@app.get("/weights")
def weights():
    if AN is None:
        return {"ok": False, "error": "Model not learned yet."}
    return {"ok": True, "W": AN.W.tolist(), "N": N_GLOBAL}

@app.post("/simulate")
def simulate(payload: SimPayload):
    if AN is None:
        return {"ok": False, "error": "Model not learned yet."}

    Ainit = np.array(payload.ainit, dtype=int)
    t_MAX = int(payload.t_MAX)
    gran = payload.granularity

    # initialize
    AN.A = deepcopy(Ainit)
    def energy(a): return float(-0.5 * np.dot(a, np.dot(AN.W, a)))

    E_hist = [energy(AN.A)]
    A_hist = [AN.A.copy().tolist()]
    t = 0
    Aold = AN.A.copy()
    more = True
    N = AN.N

    while more and t < t_MAX:
      t += 1
      indices = np.random.permutation(N)
      if gran == "neuron":
          # record AFTER every single-neuron update
          for i in indices:
              field = float(np.dot(AN.W[i, :], AN.A))
              AN.A[i] = sgn(field, AN.A[i])
              E_hist.append(energy(AN.A))
              A_hist.append(AN.A.copy().tolist())
      else:
          # "sweep" = do a full sweep, then record once
          for i in indices:
              field = float(np.dot(AN.W[i, :], AN.A))
              AN.A[i] = sgn(field, AN.A[i])
          E_hist.append(energy(AN.A))
          A_hist.append(AN.A.copy().tolist())

      if np.all(AN.A == Aold):
          more = False
      Aold = AN.A.copy()

    dist = int(np.sum(Ainit != AN.A))
    return {
        "ok": True,
        "tlast": int(t),
        "dist": dist,
        "final": AN.A.tolist(),
        "E_hist": E_hist,
        "A_hist": A_hist
    }