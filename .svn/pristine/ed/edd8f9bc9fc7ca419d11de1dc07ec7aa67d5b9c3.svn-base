// JS port of attractor.py (Arya Teymourlouei & Dr. James Reggia)
// energy, learn_standard with connectivity mask C, etc.

function hamdist(a, b) {
  let s = 0;
  for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) s++;
  return s;
}

// Sign activation with tie -> oldval (matches Python sgn)
function sgn(x, oldval) {
  if (x > 0) return 1;
  if (x < 0) return -1;
  return oldval;
}

// Random permutation of 0..N-1
function randPerm(N) {
  const arr = Array.from({ length: N }, (_, i) => i);
  for (let i = N - 1; i > 0; i--) {
    const j = (Math.random() * (i + 1)) | 0;
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

export class AttractorNet {
  constructor(N, C, scale = 0) {
    this.N = N;
    this.A = new Array(N).fill(0);              // activations
    this.W = Array.from({ length: N }, () => new Array(N).fill(0)); // weights
    this.E = 0;                                  // energy
    this.C = C || ones(N, N);                    // connectivity mask
    this.mu = 1.0 / N;                           // learning rate
    this.scale = scale;                          // (unused now)
  }

  // --- Learning ---

  learn(data, N, M, learn_type = "standard") {
    if (learn_type === "standard") {
      this.learn_standard(data, N, M);
    } else if (learn_type === "decay") {
      this.learn_decay(data, N, M, this.scale);
    } else if (learn_type === "iterative") {
      this.iterative_hebb(data, N, M);
    } else {
      throw new Error("invalid learn type");
    }
  }

  // Standard one-shot Hebbian learning: W += mu * C ⊙ (x x^T); diag=0
  learn_standard(data, N, M) {
    for (let p = 0; p < M; p++) {
      const x = col(data, p); // length N
      for (let i = 0; i < N; i++) {
        for (let j = 0; j < N; j++) {
          this.W[i][j] += this.mu * this.C[i][j] * (x[i] * x[j]);
        }
      }
    }
    zeroDiag(this.W);
  }

  // (Kept for parity; not needed now)
  learn_decay(data, N, M, scale) {
    for (let p = 0; p < M; p++) {
      const x = col(data, p);
      for (let i = 0; i < N; i++) {
        for (let j = 0; j < N; j++) {
          this.W[i][j] = scale * this.W[i][j] + this.mu * this.C[i][j] * (x[i] * x[j]);
        }
      }
    }
    zeroDiag(this.W);
  }

  // (Parity with Python; you can ignore for now)
  iterative_hebb(data, N, M) {
    let flag = 0;
    let step = 0;
    const max_steps = 100;
    const delta = 1;
    while (flag === 0 && step < max_steps) {
      flag = 1;
      for (let p = 0; p < M; p++) {
        const x = col(data, p);
        for (let i = 0; i < N; i++) {
          let field = 0;
          for (let k = 0; k < N; k++) field += 1 * this.C[i][k] * this.W[i][k] * x[k]; // ones((N,))
          if (field * x[i] < delta) {
            for (let k = 0; k < N; k++) {
              this.W[i][k] += (this.C[i][k] * x[k] * x[i]) / N;
            }
            flag = 0;
          }
        }
      }
      step += 1;
    }
    zeroDiag(this.W);
  }

  // --- Dynamics ---

  // Asynchronous update: random permutation, sgn with tie->oldval
  update() {
    const order = randPerm(this.N);
    for (const i of order) {
      let input = 0;
      for (let j = 0; j < this.N; j++) input += this.W[i][j] * this.A[j];
      this.A[i] = sgn(input, this.A[i]);
    }
  }

  // Energy: -0.5 * A^T W A
  energy() {
    let sum = 0;
    for (let i = 0; i < this.N; i++) {
      for (let j = 0; j < this.N; j++) sum += this.A[i] * this.W[i][j] * this.A[j];
    }
    return -0.5 * sum;
  }

  // Simulate with a callback per timestep (for UI updates).
  // Returns { tlast, dist } like Python.
  simulate(Ainit, { tMax = 20, onStep } = {}) {
    let t = 0;
    this.A = Ainit.slice();
    this.E = this.energy();
    let Aold = this.A.slice();

    if (onStep) onStep({ t, E: this.E, A: this.A.slice() });

    let more = true, tlast = 0, dist = 0;

    while (more && t < tMax) {
      t += 1;
      this.update();
      this.E = this.energy();
      if (onStep) onStep({ t, E: this.E, A: this.A.slice() });

      // fixed point?
      if (arraysEqual(this.A, Aold)) {
        tlast = t;
        dist = hamdist(Ainit, this.A);
        more = false;
      }
      Aold = this.A.slice();
    }

    if (more) { // not at fixed point but hit tMax
      tlast = t;
      dist = hamdist(Ainit, this.A);
    }
    return { tlast, dist };
  }
}

// ----- helpers -----

function arraysEqual(a, b) {
  if (a.length !== b.length) return false;
  for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return false;
  return true;
}

function zeroDiag(W) {
  for (let i = 0; i < W.length; i++) W[i][i] = 0;
}

function ones(n, m) {
  return Array.from({ length: n }, () => new Array(m).fill(1));
}

// data is N x M in column-major sense like NumPy (each pattern is a column)
function col(data, p) {
  const N = data.length;
  const v = new Array(N);
  for (let i = 0; i < N; i++) v[i] = data[i][p];
  return v;
}
