import React, { useState, useEffect } from "react";
import Modal from "./Modal";
import {
  serializeGraph,
  downloadText,
  toAdjacencyCSV,
  parseAdjacencyCSV,
  loadNetworkIntoGraph,
} from "../utils/ioUtils";

export default function ToolsMenu({
  open,
  mode,
  setMode,
  hopfieldCount,
  setHopfieldCount,
  rectRows,
  setRectRows,
  rectCols,
  setRectCols,
  hexRows,
  setHexRows,
  hexCols,
  setHexCols,
  onClearAll,
  graphRefs,
  setNetwork,
  objectType,
  setObjectType,
  selectedTemplate,
  setSelectedTemplate,
  customTemplates,
  setCustomTemplates,
}) {
  const [confirmOpen, setConfirmOpen] = useState(false);
  const [saveOpen, setSaveOpen] = useState(false);
  const [saveName, setSaveName] = useState("");
  const [saveFormat, setSaveFormat] = useState("json");
 // const [customTemplates, setCustomTemplates] = useState([]);

  useEffect(() => {
    if (mode === "add" && objectType === "template" && !selectedTemplate) {
      setSelectedTemplate("Hopfield Connectivity");
    }
  }, [mode, objectType, selectedTemplate, setSelectedTemplate]);

  const getInstances = () => {
    const wrapper = graphRefs?.current;
    const graph = wrapper?.graphRef?.current || null;
    const sigma = wrapper?.sigmaRef?.current || null;
    return { graph, sigma };
  };

  const handleImportFile = async (file) => {
    if (!file) return;
    try {
      const text = await file.text();
      let network;
      if (file.name.toLowerCase().endsWith(".json")) {
        network = JSON.parse(text);
        if (!network || typeof network !== "object") throw new Error("Invalid JSON");
        if (!Array.isArray(network.layout)) network.layout = [];
      } else if (file.name.toLowerCase().endsWith(".csv")) {
        network = parseAdjacencyCSV(text);
      } else throw new Error("Unsupported file type. Use .json or .csv");
      const baseName = file.name.replace(/\.[^/.]+$/, "").trim();
      if (!baseName) throw new Error("Empty filename");
      // Duplicate check (screen + built-ins)
      const exists =
        ["Hopfield Connectivity", "Rectangular Connectivity", "Hexagonal Connectivity"]
          .includes(baseName) ||
        customTemplates.some((t) => t.name.toLowerCase() === baseName.toLowerCase());
      if (exists) {
        alert(`A template named "${baseName}" already exists. Please rename your file and try again.`);
        return;
      }
      setCustomTemplates((prev) => [
        ...prev,
        { name: baseName, data: network, createdAt: Date.now() },
      ]);
} catch (err) {
       alert("Import failed: " + (err?.message || "Unknown error"));
     }
   };

  const handleSaveTemplate = () => {
    const { graph } = getInstances();
    if (!graph) return alert("Graph not ready yet.");
    const net = serializeGraph(graph);
    let name = saveName.trim() || "network";
    name = name.replace(/[\/\\:*?"<>|]/g, "_");

    if (saveFormat === "json") {
      if (!name.toLowerCase().endsWith(".json")) name += ".json";
      downloadText(name, JSON.stringify(net, null, 2));
    } else {
      if (!name.toLowerCase().endsWith(".csv")) name += ".csv";
      const csv = toAdjacencyCSV(net, { includeLayout: true });
      downloadText(name, csv);
    }

    setSaveOpen(false);
    setSaveName("");
  };

   const toggleMode = (newMode) => {
    // Single state update; toggle between the requested mode and idle
    setMode((prev) => (prev === newMode ? "idle" : newMode));
  };

  if (!open) return null;

  const baseButton = {
    flex: 1,
    padding: "10px 12px",
    borderRadius: 10,
    border: "1px solid rgba(255,255,255,0.12)",
    background: "rgba(255,255,255,0.06)",
    color: "#eaf4ff",
    cursor: "pointer",
    fontWeight: 600,
  };

  return (
    <div
      style={{
        position: "absolute",
        top: 64,
        left: 12,
        zIndex: 19,
        width: 300,
        padding: 12,
        borderRadius: 16,
        background: "rgba(20,20,26,0.92)",
        border: "1px solid rgba(255,255,255,0.1)",
        color: "#eaf4ff",
        boxShadow: "0 10px 30px rgba(0,0,0,0.45)",
        backdropFilter: "blur(10px)",
        display: "flex",
        flexDirection: "column",
        gap: 10,
      }}
    >
      <div style={{ fontWeight: 700 }}>Graph Tools</div>

      {/* Mode Toggle */}
      <div style={{ display: "flex", gap: 8 }}>
        <button
          onClick={() => toggleMode("add")}
          style={{
            ...baseButton,
            background: mode === "add" ? "#28a745" : baseButton.background,
          }}
        >
          Add
        </button>
        <button
          onClick={() => toggleMode("drag")}
          style={{
            ...baseButton,
            background: mode === "drag" ? "#007bff" : baseButton.background,
          }}
        >
          Drag
        </button>
        <button
          onClick={() => toggleMode("delete")}
          style={{
            ...baseButton,
            background: mode === "delete" ? "#dc3545" : baseButton.background,
          }}
        >
          Delete
        </button>
      </div>

      {/* Node/Template Switch */}
      <div>
        <select
          value={objectType}
          onChange={(e) => setObjectType(e.target.value)}
          style={{
            width: "100%",
            padding: "8px 10px",
            borderRadius: 10,
            border: "1px solid rgba(255,255,255,0.12)",
            background: "rgba(255,255,255,0.06)",
            color: "#eaf4ff",
            cursor: "pointer",
          }}
        >
          <option value="node" style={{ color: "#000" }}>
            Node
          </option>
          <option value="template" style={{ color: "#000" }}>
            Template
          </option>
        </select>
      </div>

      <button
        onClick={() => setConfirmOpen(true)}
        style={{ ...baseButton, background: "rgba(255,255,255,0.06)" }}
      >
        Clear All
      </button>

      {/* Templates */}
      <div style={{ marginTop: 4 }}>
        <div style={{ fontWeight: 600, marginBottom: 6 }}>Templates</div>
        <div
          style={{
            maxHeight: 140,
            overflowY: "auto",
            border: "1px solid rgba(255,255,255,0.1)",
            borderRadius: 8,
            background: "rgba(255,255,255,0.03)",
          }}
        >
          {[
            { name: "Hopfield Connectivity", builtIn: true },
            { name: "Rectangular Connectivity", builtIn: true },
            { name: "Hexagonal Connectivity", builtIn: true },
            ...customTemplates.map((t) => ({ ...t, builtIn: false })),
          ].map((t, i) => (
            <div
              key={t.name}
              onClick={() => setSelectedTemplate(t.name)}
              draggable={!t.builtIn}
              onDragStart={(e) => {
                if (t.builtIn) return;
                e.dataTransfer.setData("application/x-template-name", t.name);
                e.dataTransfer.effectAllowed = "copy";
              }}
              style={{
                padding: "8px 10px",
                cursor: "pointer",
                background:
                  selectedTemplate === t.name
                    ? "rgba(30, 144, 255, 0.35)"
                    : "transparent",
                borderBottom:
                  i === customTemplates.length + 2
                    ? "none"
                    : "1px solid rgba(255,255,255,0.08)",
                display: "flex",
                justifyContent: "space-between",
                alignItems: "center",
              }}
            >
              <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                <span>
                  {t.name}{" "}
                  <span
                    style={{
                      fontSize: 11,
                      opacity: 0.8,
                      padding: "2px 6px",
                      borderRadius: 6,
                      background: t.builtIn ? "rgba(255,255,255,0.08)" : "rgba(0,200,83,0.18)",
                      border: "1px solid rgba(255,255,255,0.1)",
                      marginLeft: 4,
                    }}
                  >
                    {t.builtIn ? "Built-in" : "Imported"}
                  </span>
                </span>
              </div>
              {!t.builtIn && (
                <div style={{ display: "flex", gap: 6 }}>
                  {/* Pencil (rename) */}
                  <button
                    aria-label={`Rename ${t.name}`}
                    title="Rename"
                    onClick={(e) => {
                      e.stopPropagation();
                      const newName = prompt("Rename template:", t.name)?.trim();
                      if (!newName || newName === t.name) return;
                      const conflict =
                        ["Hopfield Connectivity", "Rectangular Connectivity", "Hexagonal Connectivity"].includes(newName) ||
                        customTemplates.some((ct) => ct.name.toLowerCase() === newName.toLowerCase());
                      if (conflict) {
                        alert(`A template named "${newName}" already exists. Choose a different name.`);
                        return;
                      }
                      setCustomTemplates(prev =>
                        prev.map((ct) => (ct.name === t.name ? { ...ct, name: newName } : ct))
                      );
                      if (selectedTemplate === t.name) setSelectedTemplate(newName);
                    }}
                    style={{
                      border: "none",
                      background: "transparent",
                      cursor: "pointer",
                      padding: 4,
                      lineHeight: 0,
                      color: "#eaf4ff",
                    }}
                  >
                    ✎
                  </button>
                  {/* Trash (delete) */}
                  <button
                    aria-label={`Delete ${t.name}`}
                    title="Delete"
                    onClick={(e) => {
                      e.stopPropagation();
                      if (!confirm(`Delete "${t.name}"? This cannot be undone.`)) return;
                      try {
                        setCustomTemplates((prev) => prev.filter((ct) => ct.name !== t.name));
                        if (selectedTemplate === t.name) setSelectedTemplate("Hopfield Connectivity");
                      } catch (err) {
                        alert("Deletion failed: " + (err?.message || "Unknown error"));
                      }
                    }}
                    style={{
                      border: "none",
                      background: "transparent",
                      cursor: "pointer",
                      padding: 4,
                      lineHeight: 0,
                      color: "#ff6b6b",
                    }}
                  >
                    🗙
                  </button>
                </div>
              )}
  </div>
           ))}
         </div>
       </div>
      {/* Dynamic Inputs */}
      {selectedTemplate === "Hopfield Connectivity" && (
        <div style={{ marginTop: 10 }}>
          <label style={{ display: "block", fontSize: 13, marginBottom: 4 }}>
            Node Count
          </label>
          <input
            type="number"
            min="1"
            value={hopfieldCount}
            onChange={(e) => setHopfieldCount(e.target.value)}
            style={{
              width: "100%",
              padding: "6px 8px",
              borderRadius: 8,
              border: "1px solid rgba(255,255,255,0.15)",
              background: "rgba(255,255,255,0.07)",
              color: "#eaf4ff",
            }}
          />
        </div>
      )}

      {(selectedTemplate === "Rectangular Connectivity" ||
        selectedTemplate === "Hexagonal Connectivity") && (
        <div style={{ marginTop: 10 }}>
          <label style={{ display: "block", fontSize: 13, marginBottom: 4 }}>
            Rows
          </label>
          <input
            type="number"
            min="1"
            value={
              selectedTemplate === "Rectangular Connectivity"
                ? rectRows
                : hexRows
            }
            onChange={(e) =>
              selectedTemplate === "Rectangular Connectivity"
                ? setRectRows(e.target.value)
                : setHexRows(e.target.value)
            }
            style={{
              width: "100%",
              padding: "6px 8px",
              borderRadius: 8,
              border: "1px solid rgba(255,255,255,0.15)",
              background: "rgba(255,255,255,0.07)",
              color: "#eaf4ff",
              marginBottom: 8,
            }}
          />

          <label style={{ display: "block", fontSize: 13, marginBottom: 4 }}>
            Columns
          </label>
          <input
            type="number"
            min="1"
            value={
              selectedTemplate === "Rectangular Connectivity"
                ? rectCols
                : hexCols
            }
            onChange={(e) =>
              selectedTemplate === "Rectangular Connectivity"
                ? setRectCols(e.target.value)
                : setHexCols(e.target.value)
            }
            style={{
              width: "100%",
              padding: "6px 8px",
              borderRadius: 8,
              border: "1px solid rgba(255,255,255,0.15)",
              background: "rgba(255,255,255,0.07)",
              color: "#eaf4ff",
            }}
          />
        </div>
      )}

      {/* Add / Save Template */}
      <div style={{ display: "flex", flexDirection: "column", gap: 8, marginTop: 10 }}>
        <label
          style={{
            ...baseButton,
            textAlign: "center",
            fontSize: "14px",
            fontWeight: 600,
            lineHeight: "1.4",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
          }}
        >
          Add Template
          <input
            type="file"
            accept=".json,.csv"
            onChange={(e) => handleImportFile(e.target.files?.[0])}
            style={{ display: "none" }}
          />
        </label>
        <button
          onClick={() => setSaveOpen(true)}
          style={{ ...baseButton, textAlign: "center" }}
        >
          Save Template
        </button>
      </div>

      {/* Confirm Clear Modal */}
      <Modal open={confirmOpen} onClose={() => setConfirmOpen(false)}>
        <div style={{ marginBottom: 16 }}>
          Are you sure? You will lose all your progress.
        </div>
        <div style={{ display: "flex", justifyContent: "flex-end", gap: 10 }}>
          <button
            onClick={() => {
              setConfirmOpen(false);
              onClearAll?.();
            }}
            style={{
              padding: "6px 12px",
              borderRadius: 8,
              border: "1px solid rgba(255,255,255,0.2)",
              background: "#dc3545",
              color: "white",
              cursor: "pointer",
            }}
          >
            Yes
          </button>
          <button
            onClick={() => setConfirmOpen(false)}
            style={{
              padding: "6px 12px",
              borderRadius: 8,
              border: "1px solid rgba(255,255,255,0.2)",
              background: "rgba(255,255,255,0.1)",
              color: "white",
              cursor: "pointer",
            }}
          >
            No
          </button>
        </div>
      </Modal>

      {/* Save Template Modal */}
      <Modal open={saveOpen} onClose={() => setSaveOpen(false)}>
        <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
          <label>
            Name:
            <input
              type="text"
              value={saveName}
              onChange={(e) => setSaveName(e.target.value)}
              style={{
                width: "100%",
                padding: "8px 10px",
                borderRadius: 8,
                border: "1px solid rgba(255,255,255,0.2)",
                background: "rgba(255,255,255,0.06)",
                color: "#fff",
                marginTop: 4,
              }}
            />
          </label>

          <label>
            Format:
            <select
              value={saveFormat}
              onChange={(e) => setSaveFormat(e.target.value)}
              style={{
                width: "100%",
                padding: "8px 10px",
                borderRadius: 8,
                border: "1px solid rgba(255,255,255,0.2)",
                background: "rgba(255,255,255,0.06)",
                color: "#fff",
                marginTop: 4,
              }}
            >
              <option value="json">JSON</option>
              <option value="csv">CSV</option>
            </select>
          </label>

          <div
            style={{
              display: "flex",
              justifyContent: "flex-end",
              gap: 10,
              marginTop: 10,
            }}
          >
            <button
              onClick={() => setSaveOpen(false)}
              style={{
                padding: "6px 12px",
                borderRadius: 8,
                border: "1px solid rgba(255,255,255,0.2)",
                background: "rgba(255,255,255,0.1)",
                color: "white",
                cursor: "pointer",
              }}
            >
              Cancel
            </button>
            <button
              onClick={handleSaveTemplate}
              style={{
                padding: "6px 12px",
                borderRadius: 8,
                border: "1px solid rgba(255,255,255,0.2)",
                background: "#1a6fd6",
                color: "white",
                cursor: "pointer",
              }}
            >
              OK
            </button>
          </div>
        </div>
      </Modal>
    </div>
  );
}
